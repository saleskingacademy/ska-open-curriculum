850000014","senses":[{"def":"move or arrange oneself in a comfortable and cozy position","dna16":"8800095850000121","ex":["We cuddled against each other to keep warm","The children snuggled into their sleeping bags"],"id":"oewn-nuzzle__2.35.02..","pos":"verb","src":"wn","sym":"","syn":["cuddle","draw close","nest","nestle","snuggle"]},{"def":"rub noses","dna16":"8800095850000220","ex":[],"id":"oewn-nuzzle__2.35.00..","pos":"verb","src":"wn","sym":"","syn":["nose"]},{"def":"dig out with the snout","dna16":"8800095850000329","ex":["the pig nuzzled the truffle"],"id":"oewn-nuzzle__2.35.01..","pos":"verb","src":"wn","sym":"","syn":[]},{"def":"To push or thrust (the nose or snout, face or muzzle, or head, or an object) against or into something.","dna16":"8800095850000428","ex":[],"id":"wikt:nuzzle:verb:4","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["transitive"]},{"def":"To rub or touch (someone or something) with the nose, face, etc., or an object.","dna16":"8800095850000527","ex":["The horse nuzzled its foal’s head gently to wake him up.","She nuzzled her girlfriend in the cinema."],"id":"wikt:nuzzle:verb:5","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["transitive"]},{"def":"Chiefly of an animal: to dig (something, especially food) out of the ground using the nose or snout; to root.","dna16":"8800095850000626","ex":[],"id":"wikt:nuzzle:verb:6","pos":"verb","src":"wikt","sym":"8:1","syn":[],"tags":["transitive"]},{"def":"Often followed by in or into: to press or push the nose or snout, mouth, face, etc., against or into someone or something; to touch someone or something with the nose or snout, etc.","dna16":"8800095850000725","ex":["The bird nuzzled up to the wires of the cage."],"id":"wikt:nuzzle:verb:7","pos":"verb","src":"wikt","sym":"18:1","syn":[],"tags":["intransitive"]},{"def":"Followed by down: to settle or lie comfortably and snugly in a bed, nest, etc.; to nestle.","dna16":"8800095850000824","ex":[],"id":"wikt:nuzzle:verb:8","pos":"verb","src"