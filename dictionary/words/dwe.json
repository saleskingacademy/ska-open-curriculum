ed.","dna16":"8800041706000725","ex":[],"id":"wikt:dwell:noun:7","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"A planned delay in a timed control program.","dna16":"8800041706000824","ex":[],"id":"wikt:dwell:noun:8","pos":"noun","src":"wikt","sym":"100:1,121:1","syn":[]},{"def":"In a petrol engine, the period of time the ignition points are closed to let current flow through the ignition coil in between each spark. This is measured as an angle in degrees around the camshaft in the distributor which controls the points, for example in a 4-cylinder engine it might be 55° (spark at 90° intervals, points closed for 55° between each).","dna16":"8800041706000923","ex":[],"id":"wikt:dwell:noun:9","pos":"noun","src":"wikt","sym":"2:2,8:1,12:1,25:1,34:1,38:1,80:1","syn":[]},{"def":"To live; to reside.","dna16":"8800041706001020","ex":[],"id":"wikt:dwell:verb:10","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["intransitive","literary"]},{"def":"To linger (on); to remain fixated.","dna16":"8800041706001129","ex":["Stop dwelling on the past!"],"id":"wikt:dwell:verb:11","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["intransitive"]},{"def":"To be in a given state.","dna16":"8800041706001228","ex":[],"id":"wikt:dwell:verb:12","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["intransitive"]},{"def":"To abide; to remain; to continue.","dna16":"8800041706001327","ex":[],"id":"wikt:dwell:verb:13","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["intransitive"]}]},"dwell on":{"dna16":"8800041707000013","senses":[{"def":"delay","dna16":"8800041707000120","ex":[],"id":"oewn-dwell_on__2.42.00..","pos":"verb","src":"wn","sym":"121:1","syn":["linger over"]}]},"dwell time":{"dna16":"8800474447000011","senses":[{"def":"The period of time that a system or element of a system remains in a given state.","dna16":"8800474447000128","ex":["The drone has a dwell time of about six hours when operating from an in-theater airfield.","The part needs a total dwell time in the auto