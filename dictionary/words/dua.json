0470041000019","forms_of":["dual"],"senses":[]},"dualia tantum":{"dna16":"8800470042000018","forms_of":["duale tantum"],"senses":[]},"dualic":{"dna16":"8800470043000017","senses":[{"def":"Dual.","dna16":"8800470043000124","ex":[],"id":"wikt:dualic:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]},"dualie":{"dna16":"8800470044000016","forms_of":["dually"],"senses":[]},"dualies":{"dna16":"8800470045000015","forms_of":["dualie","dualy"],"senses":[]},"dualin":{"dna16":"8800470046000014","senses":[{"def":"An explosive substance consisting essentially of sawdust or wood pulp saturated with nitroglycerin and similar compounds.","dna16":"8800470046000121","ex":[],"id":"wikt:dualin:noun:1","pos":"noun","src":"wikt","sym":"60:1","syn":[],"tags":["dated","uncountable"]}]},"dualing":{"dna16":"8800470047000013","forms_of":["dualling","dual"],"senses":[]},"dualisable":{"dna16":"8800470048000012","forms_of":["dualizable"],"senses":[]},"dualisation":{"dna16":"8800470049000011","forms_of":["dualization"],"senses":[]},"dualisations":{"dna16":"8800470050000017","forms_of":["dualisation"],"senses":[]},"dualise":{"dna16":"8800470051000016","forms_of":["dualize"],"senses":[]},"dualised":{"dna16":"8800470052000015","forms_of":["dualise"],"senses":[]},"dualises":{"dna16":"8800470053000014","forms_of":["dualise"],"senses":[]},"dualising":{"dna16":"8800470054000013","forms_of":["dualise"],"senses":[]},"dualism":{"dna16":"8800041286000012","senses":[{"def":"the doctrine that reality consists of two basic opposing elements, often taken to be mind and matter (or mind and body), or good and evil","dna16":"8800041286000129","ex":[],"id":"oewn-dualism__1.09.00..","pos":"noun","src":"wn","sym":"2:1,18:1,62:1,64:1","syn":[]},{"def":"Duality; the condition of being double.","dna16":"8800041286000228","ex":[],"id":"wikt:dualism:noun:2","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["countable","uncountable"]},{"def":"The view that the world consists of, or is explicable in terms of, two fundamental principles, such as mind and matter or good and evil.","dna16":"8800041286000327","ex":[],"id":"wikt:dualism:noun:3","pos":"noun","src":"wikt","sym":"2:2,52:1,64:1","syn":[],"tags":["countable","uncountable"]},{"def":"The belief that the world is ruled by a pair of antagonistic forces, such as good and evil; the belief that man has two basic natures, the physical and the spiritual.","dna16":"8800041286000426","ex":[],"id":"wikt:dualism:noun:4","pos":"noun","src":"wikt","sym":"2:1,35:2,62:1,64:1","syn":[],"tags":["countable","uncountable"]},{"def":"The legal doctrine that international law must be transposed into domestic law to have effect.","dna16":"8800041286000525","ex":[],"id":"wikt:dualism:noun:5","pos":"noun","src":"wikt","sym":"24:1,52:2,94:1","syn":[],"tags":["countable","uncountable"]},{"def":"The theory, originated by Lavoisier and developed by Berzelius, that all definite compounds are binary in their nature, and consist of two distinct constituents, themselves simple or complex, and having opposite chemical or electrical affinities.","dna16":"8800041286000624","ex":[],"id":"wikt:dualism:noun:6","pos":"noun","src":"wikt","sym":"2:1,54:1,62:1,63:1","syn":[],"tags":["countable","dated","uncountable"]}]},"dualisms":{"dna16":"8800470055000012","forms_of":["dualism"],"senses":[]},"dualist":{"dna16":"8800041287000011","senses":[{"def":"an adherent of dualism","dna16":"8800041287000128","ex":[],"id":"oewn-dualist__1.18.00..","pos":"noun","src":"wn","sym":"","syn":[]},{"def":"Of or supporting dualism.","dna16":"8800041287000227","ex":["She has a strictly dualist approach to morality."],"id":"wikt:dualist:adjective:2","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]},{"def":"Any person who supports dualism, the belief in absolute good and absolute evil.","dna16":"8800041287000326","ex":["The Manicheans were dualists."],"id":"wikt:dualist:noun:3","pos":"noun","src":"wikt","sym":"0:1,35:1","syn":[]},{"def":"Any person who believes in or argues for the duality of something.","dna16":"8800041287000425","ex":[],"id":"wikt:dualist:noun:4","pos":"noun","src":"wikt","sym":"0:1","syn":[]}]},"dualistic":{"dna16":"8800041288000010","senses":[{"def":"of or relating to the philosophical doctrine of dualism","dna16":"8800041288000127","ex":["a Manichaean conflict between good and evil"],"id":"oewn-dualistic__3.01.00..","pos":"adjective","src":"wn","sym":"","syn":["Manichaean"]},{"def":"Of or relating to dualism.","dna16":"8800041288000226","ex":[],"id":"wikt:dualistic:adjective:2","pos":"adjective","src":"wikt","sym":"","syn":[]}]},"dualistic development":{"dna16":"8800470056000011","senses":[{"def":"The concept that the relationship between the rich and the poor countries is just a global version of the dualism that we see in every aspect of life; a concept that in interrelations the superior elements do little or nothing to pull up the inferior elements, and may serve to push them down.","dna16":"8800470056000128","ex":[],"id":"wikt:dualistic development:noun:1","pos":"noun","src":"wikt","sym":"2:1,17:1,23:1,25:1,54:2","syn":[],"tags":["uncountable"]}]},"dualistical":{"dna16":"8800470057000010","senses":[{"def":"Synonym of dualistic.","dna16":"8800470057000127","ex":[],"id":"wikt:dualistical:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[]}]},"dualistically":{"dna16":"8800470058000019","senses":[{"def":"In a dualistic manner.","dna16":"8800470058000126","ex":[],"id":"wikt:dualistically:adverb:1","pos":"adverb","src":"wikt","sym":"","syn":[]}]},"dualists":{"dna16":"8800470059000018","forms_of":["dualist"],"senses":[]},"dualities":{"dna16":"8800470060000015","forms_of":["duality"],"senses":[]},"duality":{"dna16":"8800041289000019","senses":[{"def":"being twofold; a classification into two opposed parts or subclasses","dna16":"8800041289000126","ex":["the dichotomy between eastern and western culture"],"id":"oewn-duality__1.14.00..","pos":"noun","src":"wn","