16":"8801385678000125","ex":["As a corollary of the Yoneda lemma, given a pair of contravariant hom functors #92;mbox#123;Hom#125;(-,A) and #92;mbox#123;Hom#125;(-,B), then any natural transformation #92;alpha from #92;mbox#123;Hom#125;(-,A) to #92;m","• Yoneda Lemma: Nat(Hom(A,–), F) ≅ F(A)\n∴ Nat(Hom(A,–), Hom(B,–)) ≅ Hom(B,A)\n∴ A ≅ B iff Hom(A,–) ≅ Hom(B,–)\ni.e. A is isomorphic to B if and only if A's network of relations is isomorphic to B's network of relations."],"id":"wikt:Yoneda lemma:noun:1","pos":"noun","src":"wikt","sym":"2:3,3:4,5:1,56:1","syn":[]}]},"Yonezawa":{"dna16":"8801385679000017","senses":[{"def":"A city in Yamagata Prefecture, Japan.","dna16":"8801385679000124","ex":[],"id":"wikt:Yonezawa:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Yong":{"dna16":"8801385680000014","senses":[{"def":"A surname.","dna16":"8801385680000121","ex":[],"id":"wikt:Yong:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]},{"def":"Synonym of Yongzhou: any of various regions and provinces of ancient and early medieval China.","dna16":"8801385680000220","ex":[],"id":"wikt:Yong:proper noun:2","pos":"proper noun","src":"wikt","sym":"4:1","syn":[],"tags":["historical"]}]},"Yong'an":{"dna16":"8801385687000017","senses":[{"def":"A county-level city of Sanming, Fujian, China, formerly a county.","dna16":"8801385687000124","ex":[],"id":"wikt:Yong'an:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Yongan":{"dna16":"8801385688000016","senses":[{"def":"A district of Kaohsiung, Taiwan.","dna16":"8801385688000123","ex":[],"id":"wikt:Yongan:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Yongchang":{"dna16":"8801385690000012","senses":[{"def":"A county of Jinchang, Gansu, in northwestern China.","dna16":"8801385690000129","ex":[],"id":"wikt:Yongchang:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Yongcheng":{"dna16":"8801385691000011","senses":[{"def":"A county-level city of Sha