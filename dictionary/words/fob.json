 or deceit to satisfy (someone); to deceitfully appease someone by giving something that is spurious or inferior from what was wanted or expected.","dna16":"8800052033000221","ex":["When I phoned up, I was fobbed off with a string of excuses."],"id":"wikt:fob off:verb:2","pos":"verb","src":"wikt","sym":"2:2","syn":[],"tags":["informal","transitive"]},{"def":"To fraudulently dispose of (goods).","dna16":"8800052033000320","ex":["He fobbed off the forgery as genuine."],"id":"wikt:fob off:verb:3","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["informal","transitive"]}]},"fob watch":{"dna16":"8800543079000018","senses":[{"def":"Synonym of pocket watch.","dna16":"8800543079000125","ex":[],"id":"wikt:fob watch:noun:1","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"An upside-down watch worn on one's clothing (favoured over wristwatches by nurses for reasons of hygiene).","dna16":"8800543079000224","ex":[],"id":"wikt:fob watch:noun:2","pos":"noun","src":"wikt","sym":"10:1","syn":[]}]},"fobbed":{"dna16":"8800543080000015","forms_of":["fob"],"senses":[]},"fobbed off":{"dna16":"8800543081000014","forms_of":["fob off"],"senses":[]},"fobbing":{"dna16":"8800543083000012","forms_of":["fob"],"senses":[]},"fobbing off":{"dna16":"8800543084000011","forms_of":["fob off"],"senses":[]},"fobbit":{"dna16":"8800543087000018","senses":[{"def":"A soldier who avoids combat by staying within the confines of a military base.","dna16":"8800543087000125","ex":[],"id":"wikt:fobbit:noun:1","pos":"noun","src":"wikt","sym":"0:1","syn":[],"tags":["US","derogatory","slang"]}]},"fobbits":{"dna16":"8800543090000013","forms_of":["fobbit"],"senses":[]},"fobby":{"dna16":"8800543094000019","senses":[{"def":"Having the characteristics of a FOB (a recent immigrant); not having assimilated into the local culture.","dna16":"8800543094000126","ex":[],"id":"wikt:fobby:adjective:1","pos":"adjective","src":"wikt","sym":"80:1","syn":[],"tags":["derogatory","slang"]}]},"fobs":{"dna16":"8800543098000015","fo