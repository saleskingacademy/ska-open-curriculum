{"J stroke":{"dna16":"8800695758000014","senses":[{"def":"A paddling technique used by the sternman of a canoe that starts with a stroke perpendicular to the boat and ends with a hook behind the back of the boat. This forms a letter \"J\" when paddling on the right side of the boat. The technique is used to overcome the tendency of the boat to turn when paddling on one side and keep the boat going straight in the water.","dna16":"8800695758000121","ex":[],"id":"wikt:J stroke:noun:1","pos":"noun","src":"wikt","sym":"2:1,4:2,8:2","syn":[]}]},"J strokes":{"dna16":"8800695759000013","forms_of":["J stroke"],"senses":[]},"JST":{"dna16":"8800705231000018","senses":[{"def":"Japan Standard Time","dna16":"8800705231000125","ex":[],"id":"wikt:JST:proper noun:1","pos":"proper noun","src":"wikt","sym":"46:1,52:1","syn":[],"tags":["initialism"]},{"def":"Japan Science and Technology Agency (独立行政法人科学技術振興機構 Dokuritsu Gyousei Houjin Kagaku Gijutsu Shinkou Kikou)","dna16":"8800705231000224","ex":[],"id":"wikt:JST:proper noun:2","pos":"proper noun","src":"wikt","sym":"","syn":[],"tags":["initialism"]},{"def":"Joseph Smith Translation of the Bible","dna16":"8800705231000323","ex":[],"id":"wikt:JST:proper noun:3","pos":"proper noun","src":"wikt","sym":"","syn":[]},{"def":"JavaScript Synthesis Technology","dna16":"8800705231000422","ex":[],"id":"wikt:JST:proper noun:4","pos":"proper noun","src":"wikt","sym":"","syn":[]},{"def":"Jubilee Sailing Trust","dna16":"8800705231000521","ex":[],"id":"wikt:JST:proper noun:5","pos":"proper noun","src":"wikt","sym":"98:1","syn":[]}]},"JSTL":{"dna16":"8800705233000016","forms_of":["JavaServer Pages Standard Tag Library"],"senses":[]},"j'st":{"dna16":"8800695769000011","forms_of":["just"],"senses":[]},"jst":{"dna16":"8800705232000017","forms_of":["just"],"senses":[]}}