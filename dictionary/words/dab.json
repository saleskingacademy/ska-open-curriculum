wn","sym":"","syn":["play around","smatter"]},{"def":"bob forward and under so as to feed off the bottom of a body of water","dna16":"8800034709000420","ex":["dabbling ducks"],"id":"oewn-dabble__2.38.01..","pos":"verb","src":"wn","sym":"","syn":[]},{"def":"To make slightly wet or soiled by spattering or sprinkling a liquid (such as water, mud, or paint) on it; to bedabble.","dna16":"8800034709000529","ex":[],"id":"wikt:dabble:verb:5","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["transitive"]},{"def":"To cause splashing by moving a body part like a bill or limb in soft mud, water, etc., often playfully; to play in shallow water; to paddle.","dna16":"8800034709000628","ex":["The children sat on the dock and dabbled their feet in the water."],"id":"wikt:dabble:verb:6","pos":"verb","src":"wikt","sym":"18:1,32:1,60:1","syn":[],"tags":["transitive"]},{"def":"To feed without diving, by submerging the head and neck underwater to seek food, often also tipping up the tail straight upwards above the water.","dna16":"8800034709000727","ex":[],"id":"wikt:dabble:verb:7","pos":"verb","src":"wikt","sym":"18:1","syn":[],"tags":["intransitive"]},{"def":"To participate or have an interest in an activity in a casual or superficial way.","dna16":"8800034709000826","ex":["She’s an actress by trade, but has been known to dabble in poetry."],"id":"wikt:dabble:verb:8","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["figuratively","intransitive"]},{"def":"A spattering or sprinkling of a liquid.","dna16":"8800034709000925","ex":[],"id":"wikt:dabble:noun:9","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"An act of splashing in soft mud, water, etc.","dna16":"8800034709001022","ex":[],"id":"wikt:dabble:noun:10","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"An act of participation in an activity in a casual or superficial way.","dna16":"8800034709001121","ex":[],"id":"wikt:dabble:noun:11","pos":"noun","src":"wikt","sym":"","syn":[]}]},"dabbled":{"dna16":"8800034710000013",