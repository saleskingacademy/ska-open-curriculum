{"HUH":{"dna16":"8800652659000015","senses":[{"def":"The station code of Hung Hom in Hong Kong.","dna16":"8800652659000122","ex":[],"id":"wikt:HUH:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Hu-ho-hao-t'e":{"dna16":"8800651861000011","forms_of":["Huhehaote"],"senses":[]},"Huh":{"dna16":"8800652660000012","senses":[{"def":"A surname from Korean.","dna16":"8800652660000129","ex":[],"id":"wikt:Huh:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Huhehaote":{"dna16":"8800652662000010","senses":[{"def":"Synonym of Hohhot: the Mandarin Chinese-derived name.","dna16":"8800652662000127","ex":[],"id":"wikt:Huhehaote:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Huhehot":{"dna16":"8800652663000019","forms_of":["Hohhot"],"senses":[]},"Huhhot":{"dna16":"8800652664000018","forms_of":["Hohhot"],"senses":[]},"Huhner":{"dna16":"8800652665000017","senses":[{"def":"A surname from German.","dna16":"8800652665000124","ex":[],"id":"wikt:Huhner:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Huhner test":{"dna16":"8800652666000016","forms_of":["Hühner test"],"senses":[]},"Huhner tests":{"dna16":"8800652667000015","forms_of":["Huhner test"],"senses":[]},"Huhs":{"dna16":"8800652668000014","forms_of":["Huh"],"senses":[]},"Huhsi":{"dna16":"8800652669000013","forms_of":["Huxi"],"senses":[]},"Huhta":{"dna16":"8800652670000010","senses":[{"def":"A surname from Finnish.","dna16":"8800652670000127","ex":[],"id":"wikt:Huhta:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Huhtas":{"dna16":"8800652671000019","forms_of":["Huhta"],"senses":[]},"huh":{"dna16":"8800652661000011","senses":[{"def":"Used to express doubt or confusion.","dna16":"8800652661000128","ex":["Huh? Where did they go?"],"id":"wikt:huh:interjection:1","pos":"interjection","src":"wikt","sym":"67:1,105:1","syn":[]},{"def":"Used to express amusement or subtle surprise.","dna16":"8800652661000227","ex":["Huh! I'm sure I locked it when I left."],"id":"wikt:huh:interjection:2","pos":"interjection","src":"wikt","sym":"101:1","syn":[]},{"def":"Used to reinforce a question.","dna16":"8800652661000326","ex":["Where were you last night? Huh?"],"id":"wikt:huh:interjection:3","pos":"interjection","src":"wikt","sym":"116:1","syn":[]},{"def":"Used either to belittle the issuer of a statement/question, or sarcastically to indicate utter agreement, and that the statement being responded to is an extreme understatement. The intonation is changed to distinguish between the two meanings - implied dullness for belittlement, and feigned surprise for utter agreement.","dna16":"8800652661000425","ex":["(belittlement) A: \"We should go to an amusement park; it would be fun.\" B: \"Huh.\"","(agreement) A: \"Murder is bad.\" B: \"Huh!\""],"id":"wikt:huh:interjection:4","pos":"interjection","src":"wikt","sym":"2:2,101:1,109:1,116:1","syn":[],"tags":["slang"]},{"def":"Used to indicate that one did not hear what was said.","dna16":"8800652661000524","ex":["Huh? Could you speak up?"],"id":"wikt:huh:interjection:5","pos":"interjection","src":"wikt","sym":"3:1,118:1","syn":[],"tags":["informal"]},{"def":"Used to create a tag question.","dna16":"8800652661000623","ex":["It's getting kind of late, huh?"],"id":"wikt:huh:interjection:6","pos":"interjection","src":"wikt","sym":"74:1,116:1","syn":[],"tags":["informal"]},{"def":"Representing the sound of heavy breathing.","dna16":"8800652661000722","ex":[],"id":"wikt:huh:interjection:7","pos":"interjection","src":"wikt","sym":"","syn":[],"tags":["onomatopoeic"]},{"def":"Representing a chuckling sound.","dna16":"8800652661000821","ex":[],"id":"wikt:huh:interjection:8","pos":"interjection","src":"wikt","sym":"","syn":[],"tags":["onomatopoeic"]},{"def":"A kiai, shouted as a limb is swung in attack.","dna16":"8800652661000920","ex":[],"id":"wikt:huh:interjection:9","pos":"interjection","src":"wikt","sym":"2:1","syn":[]}]},"huhu":{"dna16":"8800652672000018","senses":[{"def":"A beetle, Prionoplus reticularis, endemic to New Zealand.","dna16":"8800652672000125","ex":[],"id":"wikt:huhu:noun:1","pos":"noun","src":"wikt","sym":"","syn":[]}]},"huhu beetle":{"dna16":"8800652673000017","senses":[{"def":"A longhorn beetle, Prionoplus reticularis, of the Cerambycidae family; the largest endemic beetle found in New Zealand.","dna16":"8800652673000124","ex":[],"id":"wikt:huhu beetle:noun:1","pos":"noun","src":"wikt","sym":"16:1","syn":[]}]},"huhu beetles":{"dna16":"8800652674000016","forms_of":["huhu beetle"],"senses":[]},"huhus":{"dna16":"8800652675000015","forms_of":["huhu"],"senses":[]}}