ate.","dna16":"8800034763000720","ex":[],"id":"wikt:daddy:noun:7","pos":"noun","src":"wikt","sym":"0:2","syn":[],"tags":["broadly","informal"]},{"def":"A husband; also, a woman's (often older) male lover; (generally) a sexually attractive man; a hunk.","dna16":"8800034763000829","ex":[],"id":"wikt:daddy:noun:8","pos":"noun","src":"wikt","sym":"18:1,50:1","syn":[],"tags":["US","broadly","informal"]},{"def":"Often in the form the daddy of: the most significant of a number of things; a perfect example.","dna16":"8800034763000928","ex":["the daddy of them all"],"id":"wikt:daddy:noun:9","pos":"noun","src":"wikt","sym":"16:1,18:1,38:1","syn":[],"tags":["figuratively","informal"]},{"def":"A male juvenile delinquent in a reformatory, or a male prisoner in a prison, who dominates other inmates through threats and violence.","dna16":"8800034763001025","ex":[],"id":"wikt:daddy:noun:10","pos":"noun","src":"wikt","sym":"0:1,8:1","syn":[],"tags":["figuratively","informal","slang"]},{"def":"To father (a child); to beget, to sire.","dna16":"8800034763001124","ex":[],"id":"wikt:daddy:verb:11","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["Appalachia","informal","transitive"]},{"def":"Characteristic of or resembling a dad or father.","dna16":"8800034763001223","ex":[],"id":"wikt:daddy:adjective:12","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["informal","uncommon"]}]},"daddy diaper parties":{"dna16":"8800413440000016","forms_of":["daddy diaper party"],"senses":[]},"daddy diaper party":{"dna16":"8800413441000015","senses":[{"def":"Synonym of dadchelor party (“a party for a man whose partner is expecting a child”).","dna16":"8800413441000122","ex":[],"id":"wikt:daddy diaper party:noun:1","pos":"noun","src":"wikt","sym":"0:1,2:1","syn":[],"tags":["informal","rare"]}]},"daddy dom":{"dna16":"8800413442000014","senses":[{"def":"A sexual practice in which a male role-plays a paternal figure and dominates the submissive partner.","dna16":"8800413442000121","ex":[],"id":"wik