ountable"]},{"def":"An absence of linking elements in a group of words that are listed together.","dna16":"8800076106000420","ex":["Example: mother father instead of mother and father"],"id":"wikt:juxtaposition:noun:4","pos":"noun","src":"wikt","sym":"2:1,112:1","syn":[],"tags":["countable","uncountable"]},{"def":"An absence of operators in an expression.","dna16":"8800076106000529","ex":["Using juxtaposition for multiplication saves space when writing longer expressions. a#92;timesb collapses to ab."],"id":"wikt:juxtaposition:noun:5","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["countable","uncountable"]},{"def":"The extra emphasis given to a comparison when the contrasted objects are close together.","dna16":"8800076106000628","ex":["There was a poignant juxtaposition between the boys laughing in the street and the girl crying on the balcony above."],"id":"wikt:juxtaposition:noun:6","pos":"noun","src":"wikt","sym":"2:1,4:1,112:1,120:1","syn":[],"tags":["countable","uncountable"]},{"def":"Two or more contrasting sounds, colours, styles etc. placed together for stylistic effect.","dna16":"8800076106000727","ex":["The juxtaposition of the bright yellows on the dark background made the painting appear three dimensional."],"id":"wikt:juxtaposition:noun:7","pos":"noun","src":"wikt","sym":"112:1","syn":[],"tags":["countable","uncountable"]},{"def":"The close placement of two ideas to imply a link that may not exist.","dna16":"8800076106000826","ex":["Example: In 1965 the government was elected; in 1965 the economy took a dive."],"id":"wikt:juxtaposition:noun:8","pos":"noun","src":"wikt","sym":"25:1,120:1","syn":[],"tags":["countable","rhetoric","uncountable"]},{"def":"To place in juxtaposition.","dna16":"8800076106000925","ex":[],"id":"wikt:juxtaposition:verb:9","pos":"verb","src":"wikt","sym":"","syn":[]}]},"juxtapositional":{"dna16":"8800707707000019","senses":[{"def":"In, or relating to, juxtaposition.","dna16":"8800707707000126","ex":[],"id":"wikt:juxtapositio