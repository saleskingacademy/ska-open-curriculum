"noun","src":"wikt","sym":"","syn":[],"tags":["UK","dialectal"]}]},"knucker hole":{"dna16":"8800726498000012","forms_of":["knuckerhole"],"senses":[]},"knucker holes":{"dna16":"8800726499000011","forms_of":["knucker hole"],"senses":[]},"knuckerhole":{"dna16":"8800726500000018","senses":[{"def":"In English folklore, a hole in the ground said to be the home of a knucker, a dragon-like creature.","dna16":"8800726500000125","ex":[],"id":"wikt:knuckerhole:noun:1","pos":"noun","src":"wikt","sym":"60:1","syn":[]}]},"knuckerholes":{"dna16":"8800726501000017","forms_of":["knuckerhole"],"senses":[]},"knuckers":{"dna16":"8800726502000016","forms_of":["knucker"],"senses":[]},"knuckle":{"dna16":"8800077491000017","senses":[{"def":"a joint of a finger when the fist is closed","dna16":"8800077491000124","ex":[],"id":"oewn-knuckle__1.08.00..","pos":"noun","src":"wn","sym":"2:1,4:1","syn":["knuckle joint","metacarpophalangeal joint"]},{"def":"press or rub with the knuckles","dna16":"8800077491000223","ex":[],"id":"oewn-knuckle__2.35.00..","pos":"verb","src":"wn","sym":"","syn":[]},{"def":"shoot a marble while keeping one's knuckles on the ground","dna16":"8800077491000322","ex":[],"id":"oewn-knuckle__2.35.01..","pos":"verb","src":"wn","sym":"4:1","syn":[]},{"def":"Any of the joints between the bones of the fingers.","dna16":"8800077491000421","ex":[],"id":"wikt:knuckle:noun:4","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"A mechanical joint.","dna16":"8800077491000520","ex":[],"id":"wikt:knuckle:noun:5","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["broadly"]},{"def":"The curved part of the cushion at the entrance to the pockets on a cue sports table.","dna16":"8800077491000629","ex":[],"id":"wikt:knuckle:noun:6","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"The kneejoint of a quadruped, especially of a calf; formerly, the kneejoint of a human being.","dna16":"8800077491000728","ex":[],"id":"wikt:knuckle:noun:7","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":