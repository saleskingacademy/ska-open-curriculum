hapter 1, p. 223,\n[…] I do not agre"],"id":"wikt:hocus:noun:2","pos":"noun","src":"wikt","sym":"125:1","syn":[]}]},"hocus and pocus":{"dna16":"8800640719000018","forms_of":["hocus-pocus"],"senses":[]},"hocus pocus":{"dna16":"8800640720000015","forms_of":["hocus-pocus"],"senses":[]},"hocus pocuser":{"dna16":"8800640721000014","forms_of":["hocus-pocuser"],"senses":[]},"hocus pocusers":{"dna16":"8800640722000013","forms_of":["hocus pocuser"],"senses":[]},"hocus-pocus":{"dna16":"8800067131000014","senses":[{"def":"verbal misrepresentation intended to take advantage of you in some way","dna16":"8800067131000121","ex":[],"id":"oewn-hocus-pocus__1.10.00..","pos":"noun","src":"wn","sym":"40:1,85:1","syn":["hanky panky","jiggery-pokery","skulduggery","skullduggery","slickness","trickery"]},{"def":"a meaningless chant or expression used in conjuring or incantation.","dna16":"8800067131000220","ex":["This claim is substantiated by the fact that in the Netherlands, the words ‘Hocus pocus’ are usually accompanied by the additional words ‘pilatus pas’, and this is said to be based on a post-Reformation parody of the traditional Catholic ritual of transubstantiation during mass, being a Dutch corruption of the Latin words ‘Hoc est corpus’, meaning ‘this is (my) body’, and the credo ‘sub Pontio Pilato passus et sepultus est’, meaning ‘under Pontius Pilate he suffered and was buried’."],"id":"oewn-hocus-pocus__1.10.01..","pos":"noun","src":"wn","sym":"","syn":[]},{"def":"A phrase used (by a stage magician, etc.) as a magical incantation to bring about some change: abracadabra, hey presto.","dna16":"8800067131000329","ex":[],"id":"wikt:hocus-pocus:interjection:3","pos":"interjection","src":"wikt","sym":"4:1,85:1","syn":[]},{"def":"Some ineffectual action or speech, especially if intended to divert attention; nonsense.","dna16":"8800067131000428","ex":[],"id":"wikt:hocus-pocus:noun:4","pos":"noun","src":"wikt","sym":"20:1,85:1","syn":[],"tags":["uncountable","usually"]},{"def":"Religious or supernatural phenomena one holds to be nonsense or mere trickery; superstitious mumbo-jumbo.","dna16":"8800067131000527","ex":[],"id":"wikt:hocus-pocus:noun:5","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["derogatory","uncountable","usually"]},{"def":"Some action carried out to bring about change as if by magic; a trick; sleight of hand, trickery.","dna16":"8800067131000626","ex":[],"id":"wikt:hocus-pocus:noun:6","pos":"noun","src":"wikt","sym":"20:1,85:1,125:1","syn":[],"tags":["US","also","attributive","countable"]},{"def":"To play tricks or practise sleight of hand (on someone); (by extension) to cheat, to deceive.","dna16":"8800067131000725","ex":[],"id":"wikt:hocus-pocus:verb:7","pos":"verb","src":"wikt","sym":"123:1","syn":[],"tags":["ambitransitive","colloquial","dated"]}]},"hocus-pocused":{"dna16":"8800640723000012","forms_of":["hocus-pocus"],"senses":[]},"hocus-pocuser":{"dna16":"8800640724000011","senses":[{"def":"One who hocus-pocuses.","dna16":"8800640724000128","ex":[],"id":"wikt:hocus-pocuser:noun:1","pos":"noun","src":"wikt","sym":"0:1","syn":[]}]},"hocus-pocusers":{"dna16":"8800640725000010","forms_of":["hocus-pocuser"],"senses":[]},"hocus-pocuses":{"dna16":"8800640726000019","forms_of":["hocus-pocus"],"senses":[]},"hocus-pocusing":{"dna16":"8800640727000018","forms_of":["hocus-pocus"],"senses":[]},"hocus-pocussed":{"dna16":"8800640728000017","forms_of":["hocus-pocus"],"senses":[]},"hocus-pocusser":{"dna16":"8800640729000016","forms_of":["hocus-pocuser"],"senses":[]},"hocus-pocussers":{"dna16":"8800640730000013","forms_of":["hocus-pocusser"],"senses":[]},"hocus-pocusses":{"dna16":"8800640731000012","forms_of":["hocus-pocus"],"senses":[]},"hocus-pocussing":{"dna16":"8800640732000011","forms_of":["hocus-pocus"],"senses":[]},"hocused":{"dna16":"8800640733000010","forms_of":["hocus"],"senses":[]},"hocused and pocused":{"dna16":"8800640734000019","forms_of":["hocus and pocus"],"senses":[]},"hocused-pocused":{"dna16":"8800640735000018","form