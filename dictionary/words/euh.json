:"8800507225000016","forms_of":["euhemerise"],"senses":[]},"euhemerises":{"dna16":"8800507226000015","forms_of":["euhemerise"],"senses":[]},"euhemerising":{"dna16":"8800507227000014","forms_of":["euhemerise"],"senses":[]},"euhemerism":{"dna16":"8800507228000013","senses":[{"def":"The belief that legends and mythology arise from exaggerated descriptions of historical people and events.","dna16":"8800507228000120","ex":[],"id":"wikt:euhemerism:noun:1","pos":"noun","src":"wikt","sym":"0:1,35:1,81:1","syn":[],"tags":["uncountable","usually"]}]},"euhemerisms":{"dna16":"8800507229000012","forms_of":["euhemerism"],"senses":[]},"euhemerist":{"dna16":"8800507230000019","senses":[{"def":"Someone who practices or upholds euhemerism, a person who believes all or most myths and legends arose from historical origins.","dna16":"8800507230000126","ex":[],"id":"wikt:euhemerist:noun:1","pos":"noun","src":"wikt","sym":"0:2,81:1","syn":[]},{"def":"Synonym of euhemeristic: of or related to euhemerism.","dna16":"8800507230000225","ex":[],"id":"wikt:euhemerist:adjective:2","pos":"adjective","src":"wikt","sym":"","syn":[]}]},"euhemeristic":{"dna16":"8800507231000018","senses":[{"def":"Of or relating to euhemerism.","dna16":"8800507231000125","ex":[],"id":"wikt:euhemeristic:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]},"euhemeristically":{"dna16":"8800507232000017","senses":[{"def":"in a euhemeristic manner","dna16":"8800507232000124","ex":[],"id":"wikt:euhemeristically:adverb:1","pos":"adverb","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]},"euhemerists":{"dna16":"8800507233000016","forms_of":["euhemerist"],"senses":[]},"euhemerization":{"dna16":"8800507234000015","senses":[{"def":"The fanciful invention of plausible historical figures and events as an attempt to rationalize mythology and legends","dna16":"8800507234000122","ex":["The euhemerization of Taoist myth by Confucian historians sometimes led to the appearance of figures such as \"Lord Primordial Chaos\" (渾沌氏) in the imperial genealogies."],"id":"wikt:euhemerization:noun:1","pos":"noun","src":"wikt","sym":"81:1","syn":[],"tags":["derogatory","uncountable"]},{"def":"an instance of this","dna16":"8800507234000221","ex":["One such euhemerization is a Rowan Atkinson bit where he presents Jesus Christ as a misunderstood street magician."],"id":"wikt:euhemerization:noun:2","pos":"noun","src":"wikt","sym":"38:1","syn":[],"tags":["countable","derogatory"]},{"def":"Synonym of deification: the actual creation of mythology and legends from historical figures and events; (countable) an instance of this.","dna16":"8800507234000320","ex":["Much of Chinese mythology appears to have been the result of euhemerization, the later deification of Neolithic tribal leaders and inventors incompletely remembered through oral traditions and now-lost records."],"id":"wikt:euhemerization:noun:3","pos":"noun","src":"wikt","sym":"38:1,81:1","syn":[],"tags":["uncountable"]}]},"euhemerizations":{"dna16":"8800507235000014","forms_of":["euhemerization"],"senses":[]},"euhemerize":{"dna16":"8800507236000013","senses":[{"def":"To invent a plausible but fanciful historical origin for something in order to rationalize mythology and legends.","dna16":"8800507236000120","ex":["Near-synonyms: demythologize (sometimes synonymous), undeify (synonymous when personages are the direct objects)","Confucian scholars frequently euhemerized the myths used to explain religious rituals to the public."],"id":"wikt:euhemerize:verb:1","pos":"verb","src":"wikt","sym":"74:1,81:1","syn":[],"tags":["ambitransitive","derogatory"]},{"def":"To create mythology and legends from ancient historical figures and events.","dna16":"8800507236000229","ex":["Near-synonym: deify (synonymous when personages are the direct objects)","The Yellow Emperor was perhaps euhemerized from a prehistoric tribal leader."],"id":"wikt:euhemerize:verb:2","pos":"verb","src":"wikt","sym":"74:1,81:1","syn":[],"tags":["ambitransitive"]}]},"euhemerized":{"dna16":"8800507237000012","forms_of":["euhemerize"],"senses":[]},"euhemerizes":{"dna16":"8800507238000011","forms_of":["euhemerize"],"senses":[]},"euhemerizing":{"dna16":"8800507239000010","forms_of":["euhemerize"],"senses":[]},"euhermaphrodite":{"dna16":"8800507242000015","senses":[{"def":"Any animal that starts life as either male or female but becomes a hermaphrodite when mature","dna16":"8800507242000122","ex":[],"id":"wikt:euhermaphrodite:noun:1","pos":"noun","src":"wikt","sym":"4:1","syn":[]}]},"euhermaphrodites":{"dna16":"8800507243000014","forms_of":["euhermaphrodite"],"senses":[]},"euhermaphroditic":{"dna16":"8800507244000013","senses":[{"def":"Relating to euhermaphrodites","dna16":"8800507244000120","ex":[],"id":"wikt:euhermaphroditic:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]},"euhexaploid":{"dna16":"8800507245000012","senses":[{"def":"Both euploid and hexaploid","dna16":"8800507245000129","ex":[],"id":"wikt:euhexaploid:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]},"euhydrated":{"dna16":"8800507246000011","senses":[{"def":"Healthily hydrated","dna16":"8800507246000128","ex":[],"id":"wikt:euhydrated:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]},"euhydration":{"dna16":"8800507247000010","senses":[{"def":"Normal level of hydration; absence of hyperhydration or dehydration.","dna16":"8800507247000127","ex":[],"id":"wikt:euhydration:noun:1","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["uncountable"]}]},"euhymenium":{"dna16":"8800507248000019","senses":[{"def":"Hymenium in which the basidia are among the first elements formed.","dna16":"8800507248000126","ex":[],"id":"wikt:euhymenium:noun:1","pos":"noun","src":"wikt","sym":"2:1,4:1,12:1,56:1","syn":[]}]},"euhypsodont":{"dna16":"8800507249000018","senses":[{"def":"Truly hypsodont","dna16":"8800507249000125","ex":[],"id":"wikt:euhypsodont:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]}}