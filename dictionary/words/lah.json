able","uncountable"]}]},"Lahrs":{"dna16":"8800735639000013","forms_of":["Lahr"],"senses":[]},"Lahti":{"dna16":"8800735642000018","senses":[{"def":"A city and municipality, the capital of Päijänne Tavastia, Finland.","dna16":"8800735642000125","ex":[],"id":"wikt:Lahti:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[],"tags":["countable","uncountable"]},{"def":"A surname from Finnish.","dna16":"8800735642000224","ex":[],"id":"wikt:Lahti:proper noun:2","pos":"proper noun","src":"wikt","sym":"","syn":[],"tags":["countable"]}]},"Lahtis":{"dna16":"8800735643000017","forms_of":["Lahti"],"senses":[]},"Lahu":{"dna16":"8800078226000017","senses":[{"def":"a Loloish language spoken in Southwest Yunnan Province, Simao prefecture, Lancang Lahu, Menglian Dai, Lahu, and Va autonomous counties, as well as Lincang prefecture, Gengma Dai, and Va autonomous counties","dna16":"8800078226000124","ex":[],"id":"oewn-lahu__1.10.00..","pos":"noun","src":"wn","sym":"","syn":["Lahu language"]},{"def":"A member of an ethnic group that lives mainly in the mountainous regions of China, Vietnam, Laos and Thailand.","dna16":"8800078226000223","ex":[],"id":"wikt:Lahu:noun:2","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"The Sino-Tibetan language spoken by the Lahu people.","dna16":"8800078226000322","ex":[],"id":"wikt:Lahu:proper noun:3","pos":"proper noun","src":"wikt","sym":"0:1","syn":[]}]},"Lahu language":{"dna16":"8800078227000016","senses":[{"def":"a Loloish language spoken in Southwest Yunnan Province, Simao prefecture, Lancang Lahu, Menglian Dai, Lahu, and Va autonomous counties, as well as Lincang prefecture, Gengma Dai, and Va autonomous counties","dna16":"8800078227000123","ex":[],"id":"oewn-lahu_language__1.10.01..","pos":"noun","src":"wn","sym":"","syn":["Lahu"]}]},"Lahue":{"dna16":"8800735644000016","senses":[{"def":"A surname.","dna16":"8800735644000123","ex":[],"id":"wikt:Lahue:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Lahues":{"dna16":"8800735645000015","forms_of":["Lahue"],"senses":[]},"Lahug":{"dna16":"8800735646000014","senses":[{"def":"A barangay of Cebu City, Cebu, Philippines.","dna16":"8800735646000121","ex":[],"id":"wikt:Lahug:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Lahuli":{"dna16":"8800735647000013","senses":[{"def":"A Tibetic language spoken in the Lahaul and Spiti region of Himachal Pradesh, India.","dna16":"8800735647000120","ex":[],"id":"wikt:Lahuli:proper noun:1","pos":"proper noun","src":"wikt","sym":"6:1","syn":[]}]},"Lahus":{"dna16":"8800735648000012","forms_of":["Lahu"],"senses":[]},"lah":{"dna16":"8800078223000010","forms_of":["la"],"senses":[{"def":"the syllable naming the sixth (submediant) note of a major or minor scale in solmization","dna16":"8800078223000127","ex":[],"id":"oewn-lah__1.10.00..","pos":"noun","src":"wn","sym":"16:1,17:1,77:1","syn":["la"]},{"def":"Placed at the end of a sentence to accentuate the mood or attitude of the speaker.","dna16":"8800078223000226","ex":["Pitch contour: low-mid [lɑ(ː)˨], mid-falling [lɑː˧˨]","Don’t do it lah, it’s not worth it."],"id":"wikt:lah:particle:2","pos":"particle","src":"wikt","sym":"","syn":[]},{"def":"Placed at the end of a sentence to convey reassurance or express solidarity.","dna16":"8800078223000325","ex":["Pitch contour: low-mid [lɑ(ː)˨], mid-falling [lɑː˧˨]","You won’t drown one lah. The water is very shallow."],"id":"wikt:lah:particle:3","pos":"particle","src":"wikt","sym":"","syn":[]},{"def":"Indicates an attempt at expressing sympathy, conveying informality or sincerity, or establishing a rapport with the listener.","dna16":"8800078223000424","ex":["Pitch contour: low-mid [lɑ(ː)˨]","Just try your best lah, and don’t think too much about it."],"id":"wikt:lah:particle:4","pos":"particle","src":"wikt","sym":"","syn":[]},{"def":"Placed at the end of an assertive statement to express denial or dismissiveness.","dna16":"8800078223000523","ex":["Pitch contour: low-mid [lɑ(ː)˨], mid-falling [lɑː˧˨]","— I don’t think you should be cutting corners, at least put in some effort and make it look legit.\n— They won’t care one lah... I don’t have all day..."],"id":"wikt:lah:particle:5","pos":"particle","src":"wikt","sym":"114:1","syn":[]},{"def":"Used after an assertive statement to reinforce its authoritativeness, or to show that the speaker is confident with what they are saying.","dna16":"8800078223000622","ex":["Pitch contour: low-mid [lɑ(ː)˨], mid-falling [lɑː˧˨]","These shoes are too small lah."],"id":"wikt:lah:particle:6","pos":"particle","src":"wikt","sym":"2:3,4:1,104:1,114:2","syn":[]},{"def":"Asserts that something is clear, obvious or straightforward.","dna16":"8800078223000721","ex":["Pitch contour: falling [lɑ(ː)˦˨]","Near-synonym: lor (sense 2)"],"id":"wikt:lah:particle:7","pos":"particle","src":"wikt","sym":"2:1,62:1,90:1","syn":[]},{"def":"Used to tone down an imperative sentence, so it sounds more like a request or suggestion.","dna16":"8800078223000820","ex":["Pitch contour: falling [lɑ(ː)˦˨]"],"id":"wikt:lah:particle:8","pos":"particle","src":"wikt","sym":"60:1","syn":[]},{"def":"Indicates strong persuasion at the end of an imperative sentence.","dna16":"8800078223000929","ex":["Pitch contour: mid-falling [lɑː˧˨]","Don’t waste your time there lah."],"id":"wikt:lah:particle:9","pos":"particle","src":"wikt","sym":"","syn":[]},{"def":"Indicates a retrospective remark or a reassessment of one’s opinion.","dna16":"8800078223001026","ex":["Pitch contour: low-mid [lɑ(ː)˨], mid-falling [lɑː˧˨]","— Not many people would think of using a pressure cooker.\n— I mean, it’s pretty unconventional lah, I have to admit."],"id":"wikt:lah:particle:10","pos":"particle","src":"wikt","sym":"45:1","syn":[]},{"def":"Reinforces a suggestion with the implication that it is the more practical option.","dna16":"8800078223001125","ex":["Pitch contour: low-mid [lɑ(ː)˨], mid-falling [lɑː˧˨]","The nearest train station is 15 minutes away. I think we take the bus lah, hor?"],"id":"wikt:lah:particle:11","pos":"particle","src":"wikt","sym":"2:1,12:1,86:1","syn":[]},{"def":"Indicates confirmation-seeking at the end of an inferential statement.","dna16":"8800078223001224","ex":["Pitch contour: falling [lɑː˦˨]","In other words, you’re the one who started it lah!"],"id":"wikt:lah:particle:12","pos":"particle","src":"wikt","sym":"","syn":[]},{"def":"Used to express realisation, or vexation when something is already obvious.","dna16":"8800078223001323","ex":["Pitch contour: falling [lɑː˦˨]","So in the end it wasn’t my fault lah!"],"id":"wikt:lah:particle:13","pos":"particle","src":"wikt","sym":"2:1,4:1","syn":[]},{"def":"Reinforces the factuality of an assertive statement made to correct an inaccurate, underlying assumption.","dna16":"8800078223001422","ex":["Pitch contour: mid-rising [lɑ(ː)˧˦]","Oh wait it’s not today, lah. It’s on Sunday."],"id":"wikt:lah:particle:14","pos":"particle","src":"wikt","sym":"35:1,114:1","syn":[],"tags":["uncommon"]},{"def":"Used to convey a slight sense of dissatisfaction or irritation.","dna16":"8800078223001521","ex":["Pitch contour: mid-rising [lɑ(ː)˧˦]"],"id":"wikt:lah:particle:15","pos":"particle","src":"wikt","sym":"","syn":[],"tags":["uncommon"]},{"def":"Used for enumeration (when listing examples).","dna16":"8800078223001620","ex":["Pitch contour: mid [lɑː˧]"],"id":"wikt:lah:particle:16","pos":"particle","src":"wikt","sym":"4:1","syn":[],"tags":["uncommon"]},{"def":"An assertive separator, used to reverse the order of the usual topic–comment structure of a sentence.","dna16":"8800078223001729","ex":["Pitch contour: low-mid [lɑ(ː)˨]","No fun lah, you."],"id":"wikt:lah:particle:17","pos":"particle","src":"wikt","sym":"114:1","syn":[],"tags":["Malaysia","uncommon"]},{"def":"Used sarcastically.","dna16":"8800078223001828","ex":["Pitch contour: low-mid [lɑː˨], (in the example below) high-mid [lɑ(ː)˦]","No lah, no lah."],"id":"wikt:lah:particle:18","pos":"particle","src":"wikt","sym":"","syn":[],"tags":[