 noun","src":"wikt","sym":"","syn":[]}]},"Raków":{"dna16":"8801049181000010","senses":[{"def":"A settlement founded in the Sandomierz Voivodeship of Lesser Poland in 1569 as the centre of the Polish Brethren, the site of the Racovian Academy 1602–1638 and of the publication of the Racovian Catechism in 1605; formerly a town until 1869, it is now a village of the Republic of Poland and the seat of the gmina wiejska (rural commune) of the same name.","dna16":"8801049181000127","ex":[],"id":"wikt:Raków:proper noun:1","pos":"proper noun","src":"wikt","sym":"2:1,4:1,60:1","syn":[]},{"def":"A gmina wiejska (rural commune) in Kielce County in the Świętokrzyskie Voivodeship of the Republic of Poland, with its seat in the village of the same name.","dna16":"8801049181000226","ex":[],"id":"wikt:Raków:proper noun:2","pos":"proper noun","src":"wikt","sym":"60:1","syn":[]}]},"Raška":{"dna16":"8801053366000019","senses":[{"def":"A town and municipality in Raška District, Serbia.","dna16":"8801053366000126","ex":[],"id":"wikt:Raška:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]},{"def":"A district in south-west Serbia.","dna16":"8801053366000225","ex":[],"id":"wikt:Raška:proper noun:2","pos":"proper noun","src":"wikt","sym":"","syn":[]},{"def":"A river in south-west Serbia, a tributary of the Ibar.","dna16":"8801053366000324","ex":[],"id":"wikt:Raška:proper noun:3","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"rak'a":{"dna16":"8801049036000017","senses":[{"def":"A sequence of movements (including recitation, bowing, and prostration) that constitutes one of two to four cycles of Islamic prayer (salat).","dna16":"8801049036000124","ex":[],"id":"wikt:rak'a:noun:1","pos":"noun","src":"wikt","sym":"30:1","syn":[]}]},"rak'ah":{"dna16":"8801049037000016","forms_of":["rak'a"],"senses":[]},"rak'at":{"dna16":"8801049038000015","forms_of":["rak'a","rak'ah"],"senses":[]},"rakable":{"dna16":"8801049039000014","forms_of":["rakeable"],"senses":[]},"rakali":{"dna16":"8801049043000018","senses":[{"def":"An amphibious rodent, Hydromys chrysogaster, found throughout Australia, having dark fur and a white-tipped tail; the water rat.","dna16":"8801049043000125","ex":[],"id":"wikt:rakali:noun:1","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["Australia"]}]},"rakalis":{"dna16":"8801049044000017","forms_of":["rakali"],"senses":[]},"rakan":{"dna16":"8801049046000015","senses":[{"def":"A Japanese arhat.","dna16":"8801049046000122","ex":[],"id":"wikt:rakan:noun:1","pos":"noun","src":"wikt","sym":"","syn":[]}]},"rakans":{"dna16":"8801049047000014","forms_of":["rakan"],"senses":[]},"rake":{"dna16":"8800112828000016","forms_of":["raik"],"senses":[{"def":"a dissolute man in fashionable society","dna16":"8800112828000123","ex":[],"id":"oewn-rake__1.18.00..","pos":"noun","src":"wn","sym":"","syn":["blood","profligate","rakehell","rip","roue"]},{"def":"degree of deviation from a horizontal plane","dna16":"8800112828000222","ex":["the roof had a steep pitch"],"id":"oewn-rake__1.07.00..","pos":"noun","src":"wn","sym":"","syn":["pitch","slant"]},{"def":"a long-handled tool with a row of teeth at its head; used to move leaves or loosen soil","dna16":"8800112828000321","ex":[],"id":"oewn-rake__1.06.00..","pos":"noun","src":"wn","sym":"48:1","syn":[]},{"def":"move through with or as if with a rake","dna16":"8800112828000420","ex":["She raked her fingers through her hair"],"id":"oewn-rake__2.38.00..","pos":"verb","src":"wn","sym":"8:1,20:1","syn":[]},{"def":"level or smooth with a rake","dna16":"8800112828000529","ex":["rake gravel"],"id":"oewn-rake__2.35.01..","pos":"verb","src":"wn","sym":"","syn":[]},{"def":"sweep the length of","dna16":"8800112828000628","ex":["The gunfire raked the coast"],"id":"oewn-rake__2.42.10..","pos":"verb","src":"wn","sym":"","syn":[]},{"def":"examine hastily","dna16":"8800112828000727","ex":["She scanned the newspaper headlines while waiting for the taxi"],"id":"oewn-rake__2.39.00..","pos":"verb","src":"wn","sym":"70:1","syn":["glance over","run down","scan","skim"]},{"def":"gather with a rake","dna16":"8800112828000826","ex":["rake leaves"],"id":"oewn-rake__2.35.00..","pos":"verb","src":"wn","sym":"","syn":[]},{"def":"scrape gently","dna16":"8800112828000925","ex":["graze the skin"],"id":"oewn-rake__2.35.02..","pos":"verb","src":"wn","sym":"","syn":["crease","graze"]},{"def":"A garden tool with a row of pointed teeth fixed to a long handle, used for collecting debris, grass, etc., for flattening the ground, or for loosening soil; also, a similar wheel-mounted tool drawn by a horse or a tractor.","dna16":"8800112828001022","ex":[],"id":"wikt:rake:noun:10","pos":"noun","src":"wikt","sym":"48:1,60:1","syn":[]},{"def":"A tool with a straight edge at the end used by a croupier to move chips or money across a gaming table.","dna16":"8800112828001121","ex":[],"id":"wikt:rake:noun:11","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["broadly"]},{"def":"A type of lockpick that has a ridged or notched blade that moves across the pins in a pin tumbler lock, causing them to settle into a shear line.","dna16":"8800112828001220","ex":[],"id":"wikt:rake:noun:12","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["broadly"]},{"def":"A type of puffer train that leaves behind a stream of spaceships as it moves.","dna16":"8800112828001329","ex":[],"id":"wikt:rake:noun:13","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"A group of mules.","dna16":"8800112828001428","ex":[],"id":"wikt:rake:noun:14","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["collective"]},{"def":"To act upon with a rake, or as if with a rake.","dna16":"8800112828001527","ex":["She is raking the gravel path to keep it even.","We raked all the leaves into a pile."],"id":"wikt:rake:verb:15","pos":"verb","src":"wikt","sym":"20:1","syn":[]},{"def":"Often followed by in: to gather (things which are apart) together, especially quickly.","dna16":"8800112828001626","ex":["The casino is just raking in the cash; it’s like a licence to print money."],"id":"wikt:rake:verb:16","pos":"verb","src":"wikt","sym":"2:1,12:1,18:1,112:1","syn":[],"tags":["also","figuratively","transitive"]},{"def":"Often followed by an adverb or preposition such as away, off, out, etc.: to drag or pull in a certain direction.","dna16":"8800112828001725","ex":[],"id":"wikt:rake:verb:17","pos":"verb","src":"wikt","sym":"18:1,104:1","syn":[],"tags":["transitive"]},{"def":"To claw at; to scrape, to scratch; followed by away: to erase, to obliterate.","dna16":"8800112828001824","ex":["The cat’s sharp claws raked the side of my face."],"id":"wikt:rake:verb:18","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["ambitransitive","figuratively"]},{"def":"Followed by up: to bring up or uncover (something), as embarrassing information, past misdeeds, etc.","dna16":"8800112828001923","ex":[],"id":"wikt:rake:verb:19","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["ambitransitive","figuratively"]},{"def":"To search through (thoroughly).","dna16":"8800112828002020","ex":[],"id":"wikt:rake:verb:20","pos":"verb","src":"wikt","sym":"8:1","syn":[],"tags":["ambitransitive","figuratively"]},{"def":"To move (a beam of light, a glance with the eyes, etc.) across (something) with a long side-to-side motion; specifically (often military) to use a weapon to fire at (something) with a side-to-side motion; to spray with gunfire.","dna16":"8800112828002129","ex":["The enemy machine guns raked the roadway."],"id":"wikt:rake:verb:21","pos":"verb","src":"wikt","sym":"18:1,48:1,51:1,93:1","syn":[],"tags":["also","ambitransitive","figuratively"]},{"def":"To fire upon an enemy vessel from a position in line with its bow or stern, causing one's fire to travel through the length of the enemy vessel for maximum damage.","dna16":"8800112828002228","ex":[],"id":"wikt:rake:verb:22","pos":"verb","src":"wikt","sym":"8:1","syn":[],"tags":["also","ambitransitive","figuratively"]},{"def":"To cover (something) by or as if by raking things over it.","dna16":"8800112828002327","ex":[],"id":"wikt:rake:verb:23","pos":"verb","src":"wikt","sym":"20:1","syn":[],"tags":["Ireland","Northern-England","Scotland","also"]},{"def":"To pick (a lock) with a rake.","dna16":"8800112828002426","ex":[],"id":"wikt:rake:verb:24","pos":"verb","src":"wikt","sym":"","syn":[]},{"def":"The act of raking.","dna16":"8800112828002525","ex":[],"id":"wikt:rake:noun:25","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"A share of profits, takings, etc., especially if obtained illegally; specifically (gambling) the scaled commission fee taken by a cardroom operating a poker game.","dna16":"8800112828002624","ex":[],"id":"wikt:rake:noun:26","pos":"noun","src":"wikt","sym":"20:1,51:1","syn":[]},{"def":"A lot, plenty.","dna16":"8800112828002723","ex":["Jim has had a rake of trouble with his new car."],"id":"wikt:rake:noun:27","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["Ireland","Scotland","slang"]},{"def":"A course, a path, especially a narrow and steep path or route up a hillside.","dna16":"8800112828002822","ex":[],"id":"wikt:rake:noun:28","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["Northern-England","also","figuratively"]},{"def":"A fissure or mineral vein of ore traversing the strata vertically, or nearly so.","dna16":"8800112828002921","ex":[],"id":"wikt:rake:noun:29","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"A series, a succession; specifically (rail transport) a set of coupled rail vehicles, normally coaches or wagons.","dna16":"8800112828003028","ex":["The train was formed of a locomotive and a rake of six coaches."],"id":"wikt:rake:noun:30","pos":"noun","src":"wikt","sym":"51:1","syn":[],"tags":["Scotland","UK"]},{"def":"To move swiftly; to proceed rapidly.","dna16":"8800112828003127","ex":[],"id":"wikt:rake:verb:31","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["Midlands","Northern-England","Scotland","intransitive"]},{"def":"Of a bird of prey: to fly after a quarry; also, to fly away from the falconer, to go wide of the quarry being pursued.","dna16":"8800112828003226","ex":[],"id":"wikt:rake:verb:32","pos":"verb","src":"wikt","sym":"4:1","syn":[],"tags":["intransitive"]},{"def":"Rate of progress; pace, speed.","dna16":"8800112828003325","ex":[],"id":"wikt:rake:noun:33","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["Scotland"]},{"def":"To incline (something) from a perpendicular direction.","dna16":"8800112828003424","ex":["A mast rakes aft."],"id":"wikt:rake:verb:34","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["ambitransitive"]},{"def":"To provide (the bow or stern of a watercraft) with a rake (“a slant that causes it to extend beyond the keel”).","dna16":"8800112828003523","ex":[],"id":"wikt:rake:verb:35","pos":"verb","src":"wikt","sym":"32:1","syn":[],"tags":["transitive"]},{"def":"Of a watercraft: to have a rake at its bow or stern.","dna16":"8800112828003622","ex":[],"id":"wikt:rake:verb:36","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["intransitive","rare"]},{"def":"A divergence from the horizontal or perpendicular; a slant, a slope.","dna16":"8800112828003721","ex":[],"id":"wikt:rake:noun:37","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"In full, angle of rake or rake angle: the angle between the edge or face of a tool (especially a cutting tool) and a plane (usually one perpendicular to the object that the tool is being applied to).","dna16":"8800112828003820","ex":[],"id":"wikt:rake:noun:38","pos":"noun","src":"wikt","sym":"2:1,18:1,55:1,65:1,84:1,86:1","syn":[],"tags":["specifically"]},{"def":"The direction of slip during the movement of a fault, measured within the fault plane.","dna16":"8800112828003929","ex":[],"id":"wikt:rake:noun:39","pos":"noun","src":"wikt","sym":"4:1,34:1","syn":[]},{"def":"A slant of some other part of a watercraft (such as a funnel or mast) away from the perpendicular, usually towards the stern.","dna16":"8800112828004026","ex":[],"id":"wikt:rake:noun:40","pos":"noun","src":"wikt","sym":"18:1,85:1","s