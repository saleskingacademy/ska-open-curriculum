ilated.","dna16":"8800142977000426","ex":[],"id":"wikt:umlaut:noun:4","pos":"noun","src":"wikt","sym":"","syn":["trema","vowel mutation"]},{"def":"The diacritical mark ( ¨ ) placed over a vowel when it indicates a (rounded) front vowel","dna16":"8800142977000525","ex":[],"id":"wikt:umlaut:noun:5","pos":"noun","src":"wikt","sym":"4:1","syn":["trema","vowel mutation"]},{"def":"Synonym of diaeresis.","dna16":"8800142977000624","ex":["\"Naïve\" takes an umlaut because it is pronounced as two syllables."],"id":"wikt:umlaut:noun:6","pos":"noun","src":"wikt","sym":"","syn":["trema","vowel mutation"],"tags":["informal"]},{"def":"To place an umlaut over (a vowel).","dna16":"8800142977000723","ex":[],"id":"wikt:umlaut:verb:7","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["transitive"]},{"def":"To modify (a word) so that an umlaut is required in it.","dna16":"8800142977000822","ex":["an umlauting vowel"],"id":"wikt:umlaut:verb:8","pos":"verb","src":"wikt","sym":"2:1,26:1","syn":[],"tags":["transitive"]}]},"umlautable":{"dna16":"8801299632000016","senses":[{"def":"capable of being affected by umlaut","dna16":"8801299632000123","ex":["The umlautable vowels in German are a, o, u, and au.","In western Old Dutch, only short vowels were umlautable."],"id":"wikt:umlautable:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]},"umlaute":{"dna16":"8801299633000015","forms_of":["umlaut"],"senses":[]},"umlauted":{"dna16":"8801299634000014","forms_of":["umlaut"],"senses":[{"def":"Modified by the addition of an umlaut.","dna16":"8801299634000121","ex":[],"id":"wikt:umlauted:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]},"umlauting":{"dna16":"8801299635000013","forms_of":["umlaut"],"senses":[]},"umlautless":{"dna16":"8801299636000012","senses":[{"def":"Not exhibiting or marked by the phonological process of umlaut or an umlaut diacritic.","dna16":"8801299636000129","ex":[],"id":"wikt:umlautless:adjective: