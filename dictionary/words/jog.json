ed desperately to jog my memory."],"id":"wikt:jog:verb:15","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["transitive"]},{"def":"To walk or ride forward with a jolting pace; to move at a heavy pace, trudge; to move on or along.","dna16":"8800075238001629","ex":["1673, John Milton, “Another on the same” preceded by “On the University Carrier, who sickn’d in the time of his vacancy, being forbid to go to London, by reason of the Plague” referring to Thomas Hobson, in Poems, &c. up"],"id":"wikt:jog:verb:16","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["intransitive"]},{"def":"To move at a pace between walking and running, to run at a leisurely pace.","dna16":"8800075238001728","ex":["I saw her jogging in the forest yesterday."],"id":"wikt:jog:verb:17","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["intransitive"]},{"def":"To cause to move at an energetic trot.","dna16":"8800075238001827","ex":["to jog a horse"],"id":"wikt:jog:verb:18","pos":"verb","src":"wikt","sym":"32:1","syn":[],"tags":["transitive"]},{"def":"To straighten stacks of paper by lightly tapping against a flat surface.","dna16":"8800075238001926","ex":[],"id":"wikt:jog:verb:19","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["transitive"]}]},"jog bra":{"dna16":"8800703556000010","senses":[{"def":"jogging bra","dna16":"8800703556000127","ex":[],"id":"wikt:jog bra:noun:1","pos":"noun","src":"wikt","sym":"","syn":[]}]},"jog bras":{"dna16":"8800703557000019","forms_of":["jog bra"],"senses":[]},"jog on":{"dna16":"8800703558000018","senses":[{"def":"To continue with one's pursuit","dna16":"8800703558000125","ex":[],"id":"wikt:jog on:verb:1","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["idiomatic"]},{"def":"go away","dna16":"8800703558000224","ex":[],"id":"wikt:jog on:interjection:2","pos":"interjection","src":"wikt","sym":"","syn":[],"tags":["UK","idiomatic"]}]},"jog someone's memory":{"dna16":"8800703559000017","senses":[{"def":"To cause someone to remember something, suddenly; to 