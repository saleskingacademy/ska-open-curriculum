{"ANV":{"dna16":"8800202846000013","forms_of":["Army of Northern Virginia"],"senses":[]},"Anvers":{"dna16":"8800006909000012","senses":[{"def":"a busy port and financial center in northern Belgium on the Scheldt river; it has long been a center for the diamond industry and the first stock exchange was opened there in 1460","dna16":"8800006909000129","ex":[],"id":"oewn-anvers__1.15.00..","pos":"noun","src":"wn","sym":"4:1,6:1,48:1,56:1","syn":["Antwerp","Antwerpen"]}]},"Anvers Island":{"dna16":"8800202847000012","senses":[{"def":"An island of Palmer Archipelago, Antarctica.","dna16":"8800202847000129","ex":[],"id":"wikt:Anvers Island:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Anvik":{"dna16":"8800202848000011","senses":[{"def":"A city in Alaska which is home to the Deg Xit'an people.","dna16":"8800202848000128","ex":[],"id":"wikt:Anvik:proper noun:1","pos":"proper noun","src":"wikt","sym":"0:1,2:1,12:1","syn":[]}]},"anvil":{"dna16":"8800006910000019","senses":[{"def":"a heavy block of iron or steel on which hot metals are shaped by hammering","dna16":"8800006910000126","ex":[],"id":"oewn-anvil__1.06.00..","pos":"noun","src":"wn","sym":"2:1,12:1","syn":[]},{"def":"a small bone in the middle ear between the malleus and the stapes","dna16":"8800006910000225","ex":[],"id":"oewn-anvil__1.08.00..","pos":"noun","src":"wn","sym":"17:1","syn":["incus"]},{"def":"A heavy iron block used in the blacksmithing trade as a surface upon which metal can be struck and shaped.","dna16":"8800006910000324","ex":["1794, William Blake, “The Tyger,” lines 15-16,\nWhat the anvil? what dread grasp / Dare its deadly terrors clasp?"],"id":"wikt:anvil:noun:3","pos":"noun","src":"wikt","sym":"12:1","syn":["stithy"]},{"def":"The incus bone in the middle ear.","dna16":"8800006910000423","ex":[],"id":"wikt:anvil:noun:4","pos":"noun","src":"wikt","sym":"","syn":["stithy"]},{"def":"A stone or other hard surface used by a bird for breaking the shells of snails.","dna16":"8800006910000522","ex":[],"id":"wikt:anvil:noun:5","pos":"noun","src":"wikt","sym":"","syn":["stithy"]},{"def":"The non-moving surface of a micrometer against which the item to be measured is placed.","dna16":"8800006910000621","ex":[],"id":"wikt:anvil:noun:6","pos":"noun","src":"wikt","sym":"2:1,12:1,34:1","syn":["stithy"]},{"def":"A horizontal-topped mass of cloud, shaped like a blacksmith's anvil, that forms before a thunderstorm.","dna16":"8800006910000720","ex":[],"id":"wikt:anvil:noun:7","pos":"noun","src":"wikt","sym":"4:1,60:1","syn":["stithy"]},{"def":"To fashion on, or as if on, an anvil.","dna16":"8800006910000829","ex":[],"id":"wikt:anvil:verb:8","pos":"verb","src":"wikt","sym":"20:1","syn":[],"tags":["figuratively","often","transitive"]}]},"anvil cloud":{"dna16":"8800202849000010","senses":[{"def":"A tall thundercloud (cumulonimbus) whose top has reached the tropopause and become flat, creating a characteristic shape likened to an anvil.","dna16":"8800202849000127","ex":[],"id":"wikt:anvil cloud:noun:1","pos":"noun","src":"wikt","sym":"","syn":[]}]},"anvil clouds":{"dna16":"8800202850000016","forms_of":["anvil cloud"],"senses":[]},"anviled":{"dna16":"8800202851000015","forms_of":["anvil"],"senses":[]},"anvilicious":{"dna16":"8800202852000014","senses":[{"def":"Conveyed in a heavy-handed, unsubtle way; preachy.","dna16":"8800202852000121","ex":[],"id":"wikt:anvilicious:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["slang"]}]},"anviling":{"dna16":"8800202853000013","forms_of":["anvil"],"senses":[]},"anvilled":{"dna16":"8800202854000012","forms_of":["anvil"],"senses":[]},"anvillike":{"dna16":"8800202855000011","senses":[{"def":"Resembling or characteristic of an anvil.","dna16":"8800202855000128","ex":[],"id":"wikt:anvillike:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[]}]},"anvilling":{"dna16":"8800202856000010","forms_of":["anvil"],"senses":[]},"anvils":{"dna16":"8800202857000019","forms_of":["anvil"],"senses":[]},"anvil