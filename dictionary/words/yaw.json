ng them.","c. 1773, John Trumbull, The Progress of Dulness, Exeter, New Hampshire: Henry Ranlet, 1794, Part 1, p. 19,\nAnd while above he spends his breath,\nThe yawning audience nod beneath."],"id":"wikt:yawn:verb:4","pos":"verb","src":"wikt","sym":"2:1,18:1,19:1,32:1,46:1,47:1,48:1","syn":[],"tags":["intransitive"]},{"def":"To say while yawning.","dna16":"8800152857000529","ex":[],"id":"wikt:yawn:verb:5","pos":"verb","src":"wikt","sym":"4:1","syn":[]},{"def":"To present a wide opening; gape.","dna16":"8800152857000628","ex":["The canyon yawns as it has done for millions of years, and we stand looking, dumbstruck.","Death yawned before us, and I hit the brakes."],"id":"wikt:yawn:verb:6","pos":"verb","src":"wikt","sym":"117:1,119:1","syn":[]},{"def":"A particularly boring event.","dna16":"8800152857000727","ex":["The slideshow we sat through was such a yawn. I was glad when it finished."],"id":"wikt:yawn:noun:7","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["colloquial"]}]},"yawn-sigh":{"dna16":"8801382987000011","senses":[{"def":"A vocal sound of gradually descending pitch, between a yawn and a sigh, sometimes used in speech therapy.","dna16":"8801382987000128","ex":[],"id":"wikt:yawn-sigh:noun:1","pos":"noun","src":"wikt","sym":"19:1,119:1","syn":[]}]},"yawn-sighs":{"dna16":"8801382988000010","forms_of":["yawn-sigh"],"senses":[]},"yawnable":{"dna16":"8801382989000019","senses":[{"def":"Boring; tedious.","dna16":"8801382989000126","ex":[],"id":"wikt:yawnable:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["slang"]}]},"yawnathon":{"dna16":"8801382990000016","senses":[{"def":"A very boring event or situation.","dna16":"8801382990000123","ex":[],"id":"wikt:yawnathon:noun:1","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["informal"]}]},"yawnathons":{"dna16":"8801382991000015","forms_of":["yawnathon"],"senses":[]},"yawned":{"dna16":"8801382992000014","forms_of":["yawn"],"senses":[]},"yawner":{"dna16":"8800152858000015","senses":[{"def":"