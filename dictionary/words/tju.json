{"T-junction":{"dna16":"8800135155000010","senses":[{"def":"a junction where two roads or pipes etc. meet to form a T","dna16":"8800135155000127","ex":[],"id":"oewn-t-junction__1.06.00..","pos":"noun","src":"wn","sym":"6:1","syn":[]},{"def":"An intersection of routes where one road terminates as it joins a (usually higher priority) road at approximately 90°. In most countries, a give way or stop road sign will be seen at a T-junction.","dna16":"8800135155000226","ex":[],"id":"wikt:T-junction:noun:2","pos":"noun","src":"wikt","sym":"6:1,16:1,18:1","syn":[]},{"def":"A similarly shaped section in a pipe, etc.","dna16":"8800135155000325","ex":[],"id":"wikt:T-junction:noun:3","pos":"noun","src":"wikt","sym":"","syn":[]}]},"T-junctions":{"dna16":"8801229305000019","forms_of":["T-junction"],"senses":[]},"tjuringa":{"dna16":"8801265177000018","forms_of":["tjurunga"],"senses":[]},"tjuringas":{"dna16":"8801265178000017","forms_of":["tjuringa"],"senses":[]},"tjurunga":{"dna16":"8801265179000016","senses":[{"def":"An object of religious significance among Aboriginal peoples of Central Australia.","dna16":"8801265179000123","ex":[],"id":"wikt:tjurunga:noun:1","pos":"noun","src":"wikt","sym":"76:1","syn":[],"tags":["Australia"]}]},"tjurungas":{"dna16":"8801265180000013","forms_of":["tjurunga"],"senses":[]}}