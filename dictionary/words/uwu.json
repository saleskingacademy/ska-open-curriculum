{"UWU":{"dna16":"8801329999000018","forms_of":["Uva Wellassa University","United Workers Union"],"senses":[]},"UwU":{"dna16":"8801330000000013","forms_of":["uwu"],"senses":[]},"UwU speak":{"dna16":"8801330003000010","forms_of":["uwu speak"],"senses":[]},"UwU speech":{"dna16":"8801330005000018","forms_of":["uwu speech"],"senses":[]},"UwUfication":{"dna16":"8801330007000016","forms_of":["uwufication","UwUification"],"senses":[]},"UwUification":{"dna16":"8801330009000014","forms_of":["uwuification"],"senses":[]},"Uwu":{"dna16":"8801330001000012","senses":[{"def":"Synonym of Ayere (“a Nigerian language”).","dna16":"8801330001000129","ex":[],"id":"wikt:Uwu:proper noun:1","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"uwu":{"dna16":"8801330002000011","senses":[{"def":"Innocently, often cloyingly cute.","dna16":"8801330002000128","ex":[],"id":"wikt:uwu:adjective:1","pos":"adjective","src":"wikt","sym":"18:1","syn":[],"tags":["Internet"]}]},"uwu speak":{"dna16":"8801330004000019","senses":[{"def":"Synonym of uwu speech.","dna16":"8801330004000126","ex":[],"id":"wikt:uwu speak:noun:1","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["uncountable"]}]},"uwu speech":{"dna16":"8801330006000017","senses":[{"def":"A form of ironic childish text on the Internet intended to convey cuteness or innocence, produced by replacing certain letters, such as r and l with w, using childish terms, kawaii expressions and emoticons, such as uwu, owo or kaomoji.","dna16":"8801330006000124","ex":[],"id":"wikt:uwu speech:noun:1","pos":"noun","src":"wikt","sym":"8:1,104:1","syn":[],"tags":["Internet","humorous","uncountable"]}]},"uwufication":{"dna16":"8801330008000015","forms_of":["uwuification"],"senses":[]},"uwuification":{"dna16":"8801330010000011","senses":[{"def":"The process of altering text into childish, innocent or exaggeratedly soft speech, involving adding elements like baby talk, emoticons and swapping certain letters with w; conversion into uwu speech.","dna16":"8801330010000128","ex":[],"id":"wikt:uwuification:noun:1","pos":"noun","src":"wikt","sym":"8:1,60:1,104:1,119:1","syn":[],"tags":["Internet","humorous","neologism","uncountable"]},{"def":"The process of reinterpreting tough, stoic or villainous characters as soft or vulnerable, turning them into a babygirl; babygirlification.","dna16":"8801330010000227","ex":[],"id":"wikt:uwuification:noun:2","pos":"noun","src":"wikt","sym":"8:1","syn":[],"tags":["Internet","humorous","neologism","slang"]}]},"uwuing":{"dna16":"8801330011000010","senses":[{"def":"The act of caping for or defending someone or something while minimizing or downplaying misconducts","dna16":"8801330011000127","ex":[],"id":"wikt:uwuing:noun:1","pos":"noun","src":"wikt","sym":"4:1","syn":[],"tags":["Internet","derogatory","figuratively","neologism"]},{"def":"typing quirk","dna16":"8801330011000226","ex":[],"id":"wikt:uwuing:noun:2","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["Internet","colloquial","neologism","uncountable"]}]}}