ience or anger","dna16":"8800088465000123","ex":["made an irritated gesture","feeling nettled from the constant teasing"],"id":"oewn-miffed__5.00.00.displeased.00","pos":"adjective","src":"wn","sym":"103:1","syn":["annoyed","irritated","nettled","peeved","pissed","pissed off"]},{"def":"Somewhat indignant, irritated, angry, in a snit, put out or annoyed.","dna16":"8800088465000222","ex":[],"id":"wikt:miffed:adjective:2","pos":"adjective","src":"wikt","sym":"103:1","syn":[],"tags":["informal"]},{"def":"Confused; unable to understand.","dna16":"8800088465000321","ex":[],"id":"wikt:miffed:adjective:3","pos":"adjective","src":"wikt","sym":"66:1,106:1","syn":[],"tags":["UK","regional"]}]},"miffier":{"dna16":"8800819946000013","forms_of":["miffy"],"senses":[]},"miffiest":{"dna16":"8800819947000012","forms_of":["miffy"],"senses":[]},"miffily":{"dna16":"8800819948000011","senses":[{"def":"In a miffy or irritable manner.","dna16":"8800819948000128","ex":[],"id":"wikt:miffily:adverb:1","pos":"adverb","src":"wikt","sym":"","syn":[]}]},"miffiness":{"dna16":"8800819949000010","senses":[{"def":"The quality of being miffy, or easily irritated.","dna16":"8800819949000127","ex":[],"id":"wikt:miffiness:noun:1","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["uncountable"]}]},"miffing":{"dna16":"8800819950000016","forms_of":["miff"],"senses":[]},"miffs":{"dna16":"8800819955000011","forms_of":["miff"],"senses":[]},"miffy":{"dna16":"8800819956000010","senses":[{"def":"Easily irritated or offended.","dna16":"8800819956000127","ex":[],"id":"wikt:miffy:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["informal"]},{"def":"Particular; fussy.","dna16":"8800819956000226","ex":[],"id":"wikt:miffy:adjective:2","pos":"adjective","src":"wikt","sym":"51:1","syn":[],"tags":["dated","informal"]}]}}