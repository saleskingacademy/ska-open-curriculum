or demonstrability of God or other deity.","dna16":"8800002932000525","ex":["She left the church when she had become agnostic."],"id":"wikt:agnostic:adjective:5","pos":"adjective","src":"wikt","sym":"25:1,105:1","syn":[]},{"def":"Having no firmly held opinions on something.","dna16":"8800002932000624","ex":["I'm agnostic on whether ethanol is a green fuel.","He says he's agnostic concerning the Secretary's claims."],"id":"wikt:agnostic:adjective:6","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["informal","usually"]},{"def":"Of or relating to agnosticism or its adherents.","dna16":"8800002932000723","ex":["His agnostic viewpoint is summarized in his book."],"id":"wikt:agnostic:adjective:7","pos":"adjective","src":"wikt","sym":"","syn":[]},{"def":"Unaware or noncommittal regarding the specific nature of the components or input with which it interacts.","dna16":"8800002932000822","ex":["The socket communications layer is agnostic with regard to its underlying transport mechanism—it is “transport-agnostic”.","The software's registration key is platform agnostic and will work on both x86 and ARM processors."],"id":"wikt:agnostic:adjective:8","pos":"adjective","src":"wikt","sym":"12:1","syn":[]},{"def":"A person who holds to a form of agnosticism, especially uncertainty of the existence of a deity.","dna16":"8800002932000921","ex":[],"id":"wikt:agnostic:noun:9","pos":"noun","src":"wikt","sym":"0:1","syn":[]}]},"agnostical":{"dna16":"8800002933000011","forms_of":["agnostic"],"senses":[{"def":"uncertain of all claims to knowledge","dna16":"8800002933000128","ex":[],"id":"oewn-agnostical__3.00.00..","pos":"adjective","src":"wn","sym":"25:1,37:1","syn":["agnostic"]}]},"agnostically":{"dna16":"8800173510000011","senses":[{"def":"In an agnostic manner; not having or expressing a firm opinion on something.","dna16":"8800173510000128","ex":[],"id":"wikt:agnostically:adverb:1","pos":"adverb","src":"wikt","sym":"45:1,114:1","syn":[]},{"def":"Toward, or from the perspective of, agnosticism.","dna16":"8800173510000227","ex":["She is agnostically inclined, despite her strict religious upbringing.","What you call “God” they refer to agnostically as “the universe.”"],"id":"wikt:agnostically:adverb:2","pos":"adverb","src":"wikt","sym":"","syn":[]}]},"agnosticism":{"dna16":"8800002934000010","senses":[{"def":"a religious orientation of doubt; a denial of ultimate knowledge of the existence of God","dna16":"8800002934000127","ex":["agnosticism holds that you can neither prove nor disprove God's existence"],"id":"oewn-agnosticism__1.09.01..","pos":"noun","src":"wn","sym":"105:1","syn":[]},{"def":"the disbelief in any claims of ultimate knowledge","dna16":"8800002934000226","ex":[],"id":"oewn-agnosticism__1.09.00..","pos":"noun","src":"wn","sym":"37:1","syn":["scepticism","skepticism"]},{"def":"The view that absolute truth or ultimate certainty is unattainable, especially regarding knowledge not based on experience or perceivable phenomena.","dna16":"8800002934000325","ex":[],"id":"wikt:agnosticism:noun:3","pos":"noun","src":"wikt","sym":"3:1","syn":[],"tags":["countable","uncountable"]},{"def":"The view that the existence of God or of all deities is unknown, unknowable, unproven, or unprovable.","dna16":"8800002934000424","ex":["Holonyms: epistemology, cosmology, ontology, philosophy"],"id":"wikt:agnosticism:noun:4","pos":"noun","src":"wikt","sym":"2:1,35:1,47:1","syn":[],"tags":["countable","uncountable"]},{"def":"Doubt, uncertainty, or scepticism regarding the existence of a god or gods.","dna16":"8800002934000523","ex":["1956, January 31ˢᵗ: Alan Alexander Milne; quoted in:","The Old Testament is responsible for more atheism, agnosticism, disbelief — call it what you will — than any book ever written; it has emptied more churches than all the counterattractions of cinema, motor bicycle and go"],"id":"wikt:agnosticism:noun:5","pos":"noun","src":"wikt","sym":"105:1","syn":[],"tags":["countable","uncountable"]},{"def":"Doubt, uncertainty, or scepticism regarding any subject of dispute.","dna16":"8800002934000622","ex":[],"id":"wikt:agnosticism:noun:6","pos":"noun","src":"wikt","sym":"105:1","syn":[],"tags":["broadly","countable","uncountable"]}]},"agnosticisms":{"dna16":"8800173511000010","forms_of":["agnosticism"],"senses":[]},"agnosticize":{"dna16":"8800173512000019","senses":[{"def":"To make agnostic.","dna16":"8800173512000126","ex":[],"id":"wikt:agnosticize:verb:1","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["transitive"]},{"def":"To become agnostic.","dna16":"8800173512000225","ex":[],"id":"wikt:agnosticize:verb:2","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["intransitive","rare"]}]},"agnosticized":{"dna16":"8800173513000018","forms_of":["agnosticize"],"senses":[]},"agnosticizes":{"dna16":"8800173514000017","forms_of":["agnosticize"],"senses":[]},"agnosticizing":{"dna16":"8800173515000016","forms_of":["agnosticize"],"senses":[]},"agnostics":{"dna16":"8800173516000015","forms_of":["agnostic"],"senses":[]},"agnostid":{"dna16":"8800173517000014","senses":[{"def":"A trilobite of the order †Agnostida.","dna16":"8800173517000121","ex":[],"id":"wikt:agnostid:noun:1","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"Of or relating to the family †Agnostida of trilobites.","dna16":"8800173517000220","ex":[],"id":"wikt:agnostid:adjective:2","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]},"agnostids":{"dna16":"8800173518000013","forms_of":["agnostid"],"senses":[]},"agnostine":{"dna16":"8800173519000012","senses":[{"def":"Any trilobite in the superfamily †Agnostina.","dna16":"8800173519000129","ex":[],"id":"wikt:agnostine:noun:1","pos":"noun","src":"wikt","sym":"","syn":[]},{"def":"Of or relating to the superfamily †Agnostina of trilobites.","dna16":"8800173519000228","ex":[],"id":"wikt:agnostine:adjective:2","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]},"agnostines":{"dna16":"8800173520000019","forms_of":["agnostine"],"senses":[