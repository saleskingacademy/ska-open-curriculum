6":"8800019781000018","senses":[{"def":"sound of rapid vibration","dna16":"8800019781000125","ex":["the buzz of a bumble bee"],"id":"oewn-buzz__1.11.00..","pos":"noun","src":"wn","sym":"","syn":["bombilation","bombination"]},{"def":"a confusion of activity and gossip","dna16":"8800019781000224","ex":["the buzz of excitement was so great that a formal denial was issued"],"id":"oewn-buzz__1.04.00..","pos":"noun","src":"wn","sym":"67:1","syn":[]},{"def":"make a buzzing sound","dna16":"8800019781000323","ex":["bees were buzzing around the hive"],"id":"oewn-buzz__2.39.00..","pos":"verb","src":"wn","sym":"","syn":["bombilate","bombinate"]},{"def":"fly low","dna16":"8800019781000422","ex":["Planes buzzed the crowds in the square"],"id":"oewn-buzz__2.38.00..","pos":"verb","src":"wn","sym":"17:1","syn":[]},{"def":"be noisy with activity","dna16":"8800019781000521","ex":["This office is buzzing with activity"],"id":"oewn-buzz__2.42.00..","pos":"verb","src":"wn","sym":"","syn":["hum","seethe"]},{"def":"call with a buzzer","dna16":"8800019781000620","ex":["he buzzed the servant"],"id":"oewn-buzz__2.32.00..","pos":"verb","src":"wn","sym":"","syn":[]},{"def":"A continuous humming noise, as of bees; a confused murmur, as of general conversation in low tones.","dna16":"8800019781000729","ex":[],"id":"wikt:buzz:noun:7","pos":"noun","src":"wikt","sym":"17:1,50:1","syn":[],"tags":["countable","uncountable"]},{"def":"A whisper.","dna16":"8800019781000828","ex":[],"id":"wikt:buzz:noun:8","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["countable","uncountable"]},{"def":"The audible friction of voiced consonants.","dna16":"8800019781000927","ex":[],"id":"wikt:buzz:noun:9","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["countable","uncountable"]},{"def":"A rush or feeling of energy or excitement; a feeling of slight intoxication.","dna16":"8800019781001024","ex":["Still feeling the buzz from the coffee, he pushed through the last of the homework."],"id":"wikt:buzz:noun:10","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["countable","informal","uncountable"]},{"def":"A telephone call or e-mail.","dna16":"8800019781001123","ex":[],"id":"wikt:buzz:noun:11","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["countable","informal","uncountable"]},{"def":"Major topic of conversation; widespread rumor; information spread behind the scenes.","dna16":"8800019781001222","ex":["Allen Gregory DeLongpre: Who's he?\nPatrick: He's only the most popular kid in school.\nAllen Gregory: Ah, the two heavyweights finally meet. Sure you're tired of all the buzz. Allen Gregory DeLongpre."],"id":"wikt:buzz:noun:12","pos":"noun","src":"wikt","sym":"16:1,37:1","syn":[],"tags":["countable","informal","uncountable"]},{"def":"Synonym of fizz-buzz (“counting game”).","dna16":"8800019781001321","ex":[],"id":"wikt:buzz:noun:13","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["uncountable"]},{"def":"To make a low, continuous, humming or sibilant sound, like that made by bees with their wings.","dna16":"8800019781001420","ex":[],"id":"wikt:buzz:verb:14","pos":"verb","src":"wikt","sym":"17:1,60:1","syn":[],"tags":["intransitive"]},{"def":"To utter a murmuring sound; to speak with a low, humming voice.","dna16":"8800019781001529","ex":[],"id":"wikt:buzz:verb:15","pos":"verb","src":"wikt","sym":"17:1,119:1","syn":[],"tags":["broadly","intransitive"]},{"def":"Of a group of people, to talk about some interesting topic excitedly.","dna16":"8800019781001628","ex":[],"id":"wikt:buzz:verb:16","pos":"verb","src":"wikt","sym":"0:1,85:1,119:1","syn":[],"tags":["intransitive"]},{"def":"To fly while making such a sound.","dna16":"8800019781001727","ex":["A fly was buzzing past me."],"id":"wikt:buzz:verb:17","pos":"verb","src":"wikt","sym":"4:1","syn":[],"tags":["intransitive"]},{"def":"To show a high level of activity and haste, energization or excitement, to be busy as a bee in one’s actions but perhaps mentally charged.","dna16":"8800019781001826","ex":["The room was buzzing with excitement."],"id":"wikt:buzz:verb:18","pos":"verb","src":"wikt","sym":"16:1,25:1","syn":[],"tags":["colloquial"]},{"def":"To whisper; to communicate, as tales, in an undertone; to spread, as a report, by whispers or secretly.","dna16":"8800019781001925","ex":[],"id":"wikt:buzz:verb:19","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["transitive"]},{"def":"To talk to incessantly or confidentially in a low humming voice.","dna16":"8800019781002022","ex":[],"id":"wikt:buzz:verb:20","pos":"verb","src":"wikt","sym":"17:1,119:1","syn":[],"tags":["transitive"]},{"def":"To fly at high speed and at a very low altitude over (an area), as to make a surprise pass.","dna16":"8800019781002121","ex":["buzzing around in small cars that dodged through traffic"],"id":"wikt:buzz:verb:21","pos":"verb","src":"wikt","sym":"16:1,17:1,101:1","syn":[],"tags":["also","figuratively","transitive"]},{"def":"To cut (the hair) in a close-cropped military style, or buzzcut.","dna16":"8800019781002220","ex":[],"id":"wikt:buzz:verb:22","pos":"verb","src":"wikt","sym":"59:1,120:1","syn":[],"tags":["transitive"]},{"def":"To throw swiftly.","dna16":"8800019781002329","ex":[],"id":"wikt:buzz:verb:23","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["transitive"]},{"def":"To communicate with (a person) by means of a buzzer.","dna16":"8800019781002428","ex":[],"id":"wikt:buzz:verb:24","pos":"verb","src":"wikt","sym":"2:1","syn":[],"tags":["transitive"]}]},"buzz about":{"dna16":"8800307083000012","senses":[{"def":"To run around or scurry around.","dna16":"8800307083000129","ex":[],"id":"wikt:buzz about:verb:1","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["transitive"]}]},"buzz bar":{"dna16":"8800307084000011","senses":[{"def":"A kind of safety restraint on a rollercoaster, in the form of a bar that locks in place above the rider's lap.","dna16":"8800307084000128","ex":[],"id":"wikt:buzz bar:noun:1","pos":"noun","src":"wikt","sym":"92:1","syn":[]}]},"buzz bars":{"dna16":"8800307085000010"