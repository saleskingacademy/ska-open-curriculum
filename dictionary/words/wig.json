l"]},{"def":"To move gently in one direction and then another; to wig or wiggle, to wag or waggle.","dna16":"8800150851001220","ex":[],"id":"wikt:wigwag:verb:12","pos":"verb","src":"wikt","sym":"4:1,56:1","syn":["wag","waggle","wig","wiggle"]},{"def":"An act of wigwagging.","dna16":"8800150851001329","ex":[],"id":"wikt:wigwag:verb:13","pos":"verb","src":"wikt","sym":"","syn":["wag","waggle","wig","wiggle"]},{"def":"To oscillate between two states.","dna16":"8800150851001428","ex":[],"id":"wikt:wigwag:verb:14","pos":"verb","src":"wikt","sym":"","syn":["wag","waggle","wig","wiggle"]},{"def":"With a wigwagging or to-and-fro motion.","dna16":"8800150851001527","ex":[],"id":"wikt:wigwag:adverb:15","pos":"adverb","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]},"wigwagged":{"dna16":"8801366714000014","forms_of":["wigwag"],"senses":[]},"wigwagger":{"dna16":"8801366715000013","senses":[{"def":"Anything that wigwags.","dna16":"8801366715000120","ex":[],"id":"wikt:wigwagger:noun:1","pos":"noun","src":"wikt","sym":"","syn":[]}]},"wigwaggers":{"dna16":"8801366716000012","forms_of":["wigwagger"],"senses":[]},"wigwagging":{"dna16":"8801366717000011","forms_of":["wigwag"],"senses":[]},"wigwags":{"dna16":"8801366718000010","forms_of":["wigwag"],"senses":[]},"wigwam":{"dna16":"8800150852000015","senses":[{"def":"a Native American lodge frequently having an oval shape and covered with bark or hides","dna16":"8800150852000122","ex":[],"id":"oewn-wigwam__1.06.00..","pos":"noun","src":"wn","sym":"18:1","syn":[]},{"def":"A dwelling having an arched framework overlaid with bark, hides, or mats, used by Native Americans in the northeastern United States.","dna16":"8800150852000221","ex":[],"id":"wikt:wigwam:noun:2","pos":"noun","src":"wikt","sym":"8:1","syn":[]},{"def":"Any more or less similar dwelling used by indigenous people in other parts of the world.","dna16":"8800150852000320","ex":["The Fuegian wigwam resembles, in size and dimensions, a haycock. It merely consists of a few broken branches stuck in the ground, and very imperfectly thatched on one side with a few tufts of grass and rushes."],"id":"wikt:wigwam:noun:3","pos":"noun","src":"wikt","sym":"0:1,60:1","syn":[],"tags":["dated","possibly"]},{"def":"To dry (flax or straw) by standing it outside in the shape of a wigwam.","dna16":"8800150852000429","ex":[],"id":"wikt:wigwam:verb:4","pos":"verb","src":"wikt","sym":"","syn":[],"tags":["transitive"]}]},"wigwam burner":{"dna16":"8801366719000019","senses":[{"def":"Synonym of beehive burner.","dna16":"8801366719000126","ex":[],"id":"wikt:wigwam burner:noun:1","pos":"noun","src":"wikt","sym":"","syn":[]}]},"wigwam burners":{"dna16":"8801366720000016","forms_of":["wigwam burner"],"senses":[]},"wigwam for a goose's bridle":{"dna16":"8801366721000015","senses":[{"def":"A hypothetical object or construct proposed as an explanation when one wishes to withhold certain information.","dna16":"8801366721000122","ex":[],"id":"wikt:wigwam for a goose's bridle:noun:1","pos":"noun","src":"wikt","sym":"4:1,66:1,104:1","syn":[],"tags":["Australia"]}]},"wigwamlike":{"dna16":"8801366722000014","senses":[{"def":"Resembling or characteristic of a wigwam.","dna16":"8801366722000121","ex":[],"id":"wikt:wigwamlike:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[]}]},"wigwammed":{"dna16":"8801366723000013","forms_of":["wigwam"],"senses":[]},"wigwamming":{"dna16":"8801366724000012","forms_of":["wigwam"],"senses":[]},"wigwams":{"dna16":"8801366725000011","forms_of":["wigwam"],"senses":[]}}