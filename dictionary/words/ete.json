:"","syn":[]}]},"eternal marriages":{"dna16":"8800505361000014","forms_of":["eternal marriage"],"senses":[]},"eternal now":{"dna16":"8800505362000013","senses":[{"def":"The condition in which all reality is experienced in the present, with the past contained only in memory and the future only in anticipation or speculation.","dna16":"8800505362000120","ex":[],"id":"wikt:eternal now:noun:1","pos":"noun","src":"wikt","sym":"2:1,12:1,117:1,119:1","syn":[],"tags":["uncountable"]},{"def":"The nature of the existence of God which is outside of time; the nature of the existence of a soul in a supposed timeless afterlife.","dna16":"8800505362000229","ex":[],"id":"wikt:eternal now:noun:2","pos":"noun","src":"wikt","sym":"2:1,12:1","syn":[],"tags":["uncountable"]}]},"eternal recurrence":{"dna16":"8800505363000012","senses":[{"def":"The belief or theory that all the events in cosmic history repeat in an endless cycle.","dna16":"8800505363000129","ex":[],"id":"wikt:eternal recurrence:noun:1","pos":"noun","src":"wikt","sym":"35:1,54:1","syn":[],"tags":["uncountable"]}]},"eternal rest":{"dna16":"8800045715000014","senses":[{"def":"euphemisms for death (based on an analogy between lying in a bed and in a tomb)","dna16":"8800045715000121","ex":["she was laid to rest beside her husband","they had to put their family pet to sleep"],"id":"oewn-eternal_rest__1.26.00..","pos":"noun","src":"wn","sym":"","syn":["eternal sleep","quietus","rest","sleep"]},{"def":"Synonym of eternal sleep.","dna16":"8800045715000220","ex":[],"id":"wikt:eternal rest:noun:2","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["uncountable"]}]},"eternal return":{"dna16":"8800505364000011","senses":[{"def":"Eternal recurrence.","dna16":"8800505364000128","ex":[],"id":"wikt:eternal return:noun:1","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["uncountable"]}]},"eternal sin":{"dna16":"8800505367000018","senses":[{"def":"The sin which is unpardonable by God and therefore make salvation impossible.","dna16":"8800505367000125","ex":["Blasphemy against the Holy Spirit is an eternal sin."],"id":"wikt:eternal sin:noun:1","pos":"noun","src":"wikt","sym":"2:1,12:1,36:1","syn":[]}]},"eternal sins":{"dna16":"8800505368000017","forms_of":["eternal sin"],"senses":[]},"eternal sleep":{"dna16":"8800045716000013","senses":[{"def":"euphemisms for death (based on an analogy between lying in a bed and in a tomb)","dna16":"8800045716000120","ex":["she was laid to rest beside her husband","they had to put their family pet to sleep"],"id":"oewn-eternal_sleep__1.26.00..","pos":"noun","src":"wn","sym":"","syn":["eternal rest","quietus","rest","sleep"]},{"def":"A magical state of suspended animation, a state of ageless, deathless, everlasting sleep. Well-known examples are Endymion (the lover of the Greek moon goddess, Selene), and the princess Sleeping Beauty.","dna16":"8800045716000229","ex":["She is, indeed, most wondrous fair: Gold of sunshine in her hair. Lips that shame the red red rose. In ageless sleep, she finds repose. The years roll by, but a hundred years, to a steadfast heart, are but a day."],"id":"wikt:eternal sleep:noun:2","pos":"noun","src":"wikt","sym":"2:2,46:1","syn":[],"tags":["uncountable"]},{"def":"Death","dna16":"8800045716000328","ex":[],"id":"wikt:eternal sleep:noun:3","pos":"noun","src":"wikt","sym":"","syn":[],"tags":["euphemistic","idiomatic","uncountable"]}]},"eternal triangle":{"dna16":"8800505369000016","senses":[{"def":"A relationship involving three persons (usually two women and one man or two men and one woman) among whom there are conflicting and competing attachments of a romantic or emotional nature.","dna16":"8800505369000123","ex":["And then there’s the eternal triangle thing with Duke fancying Olivia who fancies Sebastian."],"id":"wikt:eternal triangle:noun:1","pos":"noun","src":"wikt","sym":"2:1,18:1","syn":[],"tags":["idiomatic"]}]},"eternal triangles":{"dna16":"8800505370000013","forms_of":["eternal triangle"],"senses":[]},"eternalisation":{"dna16":