{"abjad":{"dna16":"8800158801000010","senses":[{"def":"A writing system for Arabic, historically also employed as a numeral system, in which there is one glyph (symbol or letter) for each consonant but vowels are not specified.","dna16":"8800158801000127","ex":[],"id":"wikt:abjad:noun:1","pos":"noun","src":"wikt","sym":"2:1,3:2,13:1","syn":["consonantary"]},{"def":"Any writing system in which glyphs are used to represent consonants or consonantal phonemes, but not vowels.","dna16":"8800158801000226","ex":["Languages that use abjads include Arabic, Hebrew, Persian, and Urdu. Abjads differ from syllabaries (such as the Japanese hiragana) in that the vowel quality of each letter is left unspecified, and must be inferred from "],"id":"wikt:abjad:noun:2","pos":"noun","src":"wikt","sym":"3:1,13:1","syn":["consonantary"]},{"def":"The system of abjad numerals; a numeral system in which the letters of the Arabic abjad are interpreted as numerals, typically used to enumerate lists and nested lists, as well as in numerology.","dna16":"8800158801000325","ex":["1971, Mohibbul Hasan, History of Tipu Sultan, Aakar Books, 2nd Edition, 2005 Reprint, page 399,\nThe other names had no significance, except that the initial letter of each month denoted its place in the calendar accordin"],"id":"wikt:abjad:noun:3","pos":"noun","src":"wikt","sym":"2:1,12:1,50:1","syn":["consonantary"]}]},"abjadic":{"dna16":"8800158802000019","senses":[{"def":"Of or relating to an abjad (writing system with glyphs for consonants).","dna16":"8800158802000126","ex":[],"id":"wikt:abjadic:adjective:1","pos":"adjective","src":"wikt","sym":"","syn":[],"tags":["not-comparable"]}]},"abjads":{"dna16":"8800158803000018","forms_of":["abjad"],"senses":[]},"abject":{"dna16":"8800000585000016","senses":[{"def":"of the most contemptible kind","dna16":"8800000585000123","ex":["abject cowardice","a low stunt to pull"],"id":"oewn-abject__5.00.00.contemptible.00","pos":"adjective","src":"wn","sym":"","syn":["low","low-down",