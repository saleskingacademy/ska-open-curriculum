{"Aeneas":{"dna16":"8800002391000016","senses":[{"def":"a mythical Greek warrior who was a leader on the Trojan side of the Trojan War; hero of the Aeneid","dna16":"8800002391000123","ex":[],"id":"oewn-aeneas__1.18.00..","pos":"noun","src":"wn","sym":"0:2","syn":[]},{"def":"A Trojan hero and the legendary ancestor of Romans.","dna16":"8800002391000222","ex":[],"id":"wikt:Aeneas:proper noun:2","pos":"proper noun","src":"wikt","sym":"","syn":[],"tags":["Greek","Roman"]},{"def":"A male given name from Ancient Greek.","dna16":"8800002391000321","ex":[],"id":"wikt:Aeneas:proper noun:3","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Aeneas Silvius":{"dna16":"8800002392000015","senses":[{"def":"Italian pope from 1458 to 1464 who is remembered for his unsuccessful attempt to lead a crusade against the Turks (1405-1464)","dna16":"8800002392000122","ex":[],"id":"oewn-aeneas_silvius__1.18.00..","pos":"noun","src":"wn","sym":"0:1,2:1","syn":["Enea Silvio Piccolomini","Pius II","Pope Pius II"]}]},"Aeneid":{"dna16":"8800002393000014","senses":[{"def":"an epic in Latin by Virgil; tells the adventures of Aeneas after the Trojan War; provides an illustrious historical background for the Roman Empire","dna16":"8800002393000121","ex":[],"id":"oewn-aeneid__1.10.00..","pos":"noun","src":"wn","sym":"4:1,81:1","syn":[]},{"def":"A classic epic poem, written in Latin by Virgil in the 1st century BCE (between 29 and 19 BCE), that tells the legendary story of Aeneas fleeing Troy and settling in Italy as ancestor of the Romans.","dna16":"8800002393000220","ex":[],"id":"wikt:Aeneid:proper noun:2","pos":"proper noun","src":"wikt","sym":"","syn":[]}]},"Aeneids":{"dna16":"8800169617000011","forms_of":["Aeneid"],"senses":[]},"Aengus":{"dna16":"8800002394000013","senses":[{"def":"Celtic god of love and beauty; patron deity of young men and women","dna16":"8800002394000120","ex":[],"id":"oewn-aengus__1.18.00..","pos":"noun","src":"wn","sym":"","syn":["Angus","Angus Og","Oengus"]}]},"Aeniania"